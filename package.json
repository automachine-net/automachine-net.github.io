{
  "name": "automachine-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "cms": "node -e \"require('fs').copyFileSync('node_modules/@sveltia/cms/dist/sveltia-cms.js','public/admin/sveltia-cms.js')\"",
    "detourer": "node construction/detourer.mjs",
    "predev": "npm run cms && npm run detourer",
    "dev": "astro dev",
    "prebuild": "npm run cms && npm run detourer",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@google/model-viewer": "^4.3.1",
    "@sveltia/cms": "0.205.0",
    "astro": "^7.2.10",
    "marked": "18.0.11"
  },
  "allowScripts": {
    "esbuild": true
  }
}
