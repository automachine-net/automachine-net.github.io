{
  "useTabs": true,
  "singleQuote": true,
  "printWidth": 100,
  "trailingComma": "es5",
  "plugins": ["prettier-plugin-astro"],
  "overrides": [
    { "files": "*.astro", "options": { "parser": "astro" } },
    { "files": ["*.json", "*.yml", "*.yaml", ".prettierrc"], "options": { "useTabs": false, "tabWidth": 2 } },
    { "files": "*.md", "options": { "proseWrap": "preserve" } }
  ]
}
