---
// Module « Estimateur d'ordre de prix ».
//
// Les valeurs du modèle vivent dans content/donnees/prix.json ; elles ont été validées par
// le dirigeant avant publication, car un ordre de prix public engage l'entreprise.
import Base from '../../layouts/Base.astro';
import EntetePage from '../../components/EntetePage.astro';
import EstimateurPrix from '../../components/modules/EstimateurPrix.astro';
import Appel from '../../components/blocs/Appel.astro';
---

<Base
	titre="Quel est le prix de votre machine ?"
	description="Quelques questions sur votre projet, une fourchette de prix hors taxes en retour. Avant même un premier contact."
>
	<EntetePage
		fil={[
			{ libelle: 'Accueil', href: '/' },
			{ libelle: 'Outils', href: '/outils' },
		]}
		surtitre="Outil"
		titre="Quel est le prix de votre machine ?"
		chapeau="Décrivez votre projet en quelques minutes et obtenez une estimation de prix."
	/>

	<section class="bloc bloc--blanc">
		<div class="bloc__interieur">
			<EstimateurPrix />
		</div>
	</section>

	<section class="bloc bloc--clair">
		<div class="bloc__interieur methode">
			<details class="methodologie">
				<summary>Comment cette fourchette est calculée</summary>
				<div class="methodologie__corps">
					<p>
						Le calcul additionne un socle, qui dépend de la nature du projet, et un montant par
						élément déclaré : chaque axe, chaque robot, le niveau de contrôle, la sécurité,
						l’encombrement, les fonctions logicielles et les prestations. Chaque montant se
						décompose en matériel, études et réalisation.
					</p>
					<p>
						Les montants du modèle sont des ordres de grandeur tirés de machines que nous avons
						réellement conçues et livrées.
					</p>
				</div>
			</details>
		</div>
	</section>

	<Appel
		bloc={{
			type: 'appel',
			titre: 'Passons de l’estimation au devis',
			lien_libelle: 'Décrire mon projet',
			lien_url: '/contact',
			fond: 'sombre',
		}}
	/>
</Base>

<style>
	.methodologie__corps p {
		max-width: var(--mesure);
	}
	.methodologie summary {
		cursor: pointer;
		font-family: var(--titres);
		font-weight: 600;
		font-size: 1.15rem;
		color: var(--bleu-nuit);
		list-style: none;
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}
	.methodologie summary::-webkit-details-marker {
		display: none;
	}
	.methodologie summary::before {
		content: '';
		width: 0.55rem;
		height: 0.55rem;
		border-right: 2px solid var(--bleu);
		border-bottom: 2px solid var(--bleu);
		transform: rotate(-45deg);
		transition: transform 0.2s;
		flex: 0 0 auto;
	}
	.methodologie[open] summary::before {
		transform: rotate(45deg);
	}
	.methodologie__corps {
		padding-top: 1.5rem;
	}
</style>
