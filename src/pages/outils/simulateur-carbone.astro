---
// Module « Simulateur d'empreinte carbone ».
//
// La page reste non indexée tant que les ratios de calage sur machines livrées ne sont pas
// fournis : publier un chiffre non calé engagerait l'entreprise.
//
// Ce qui relève du suivi interne — approximations à lever, données manquantes, arbitrages
// en attente — n'a pas sa place ici. C'est consigné dans CLAUDE.md.
//
// Aucun qualificatif environnemental n'est employé ici (« bas carbone », « vert »,
// « neutre »…) : la directive (UE) 2024/825 s'applique depuis le 27 septembre 2026.
import Base from '../../layouts/Base.astro';
import SimulateurCarbone from '../../components/modules/SimulateurCarbone.astro';
import facteurs from '../../../content/donnees/facteurs-carbone.json';
---

<Base
	titre="Simulateur d’empreinte carbone"
	description="Ordre de grandeur des émissions d’une machine spéciale sur son cycle de vie."
	noindex={true}
>
	<section class="bloc bloc--blanc">
		<div class="bloc__interieur entete">
			<p class="fil"><a href="/">Accueil</a> <span aria-hidden="true">›</span> Outils</p>
			<p class="surtitre">Outil en préparation</p>
			<h1>Quelle sera l’empreinte carbone de votre machine ?</h1>
			<p class="chapeau">
				<span class="a-rediger">[à relire]</span> Renseignez ce que vous savez de la machine, même
				grossièrement, puis affinez ce que vous connaissez précisément.
			</p>
		</div>
	</section>

	<section class="bloc bloc--blanc">
		<div class="bloc__interieur">
			<SimulateurCarbone />
		</div>
	</section>

	<section class="bloc bloc--clair">
		<div class="bloc__interieur methode">
			<details class="methodologie">
				<summary>Méthodologie et sources</summary>

				<div class="methodologie__corps">
					<h2>Ce que fait le calcul</h2>
					<ul>
						<li>
							<strong>Fabrication</strong> : masse de chaque famille de matériaux, multipliée par
							son facteur d’émission.
						</li>
						<li>
							<strong>Transport</strong> : masse totale multipliée par la distance de livraison et
							par le facteur du transport routier. Seule la livraison de la machine terminée est
							comptée.
						</li>
						<li>
							<strong>Usage</strong> : puissance installée, taux de charge, heures par an et durée
							de vie donnent une consommation, multipliée par le facteur du mix électrique
							français. L’outil ne vaut donc que pour un usage en France continentale.
						</li>
						<li><strong>Fin de vie</strong> : non chiffrée, et donc absente du total.</li>
					</ul>
					<p>
						Une catégorie renseignée sans détail est bornée par son matériau le moins émetteur et
						par le plus émetteur. La fourchette est alors large, et se resserre dès qu’on détaille.
					</p>
					<p>
						Le calcul se fait dans votre navigateur : rien de ce que vous saisissez ne nous
						parvient.
					</p>

					<h2>Les facteurs d’émission</h2>
					<p>
						Tous proviennent de la <strong>Base Empreinte de l’ADEME</strong>, relevés le
						{facteurs.date_releve.split('-').reverse().join('/')}. Chaque ligne porte son
						identifiant d’élément, sa valeur et l’incertitude officielle publiée avec elle. Aucune
						valeur n’est estimée. Les lignes marquées « approché » emploient un facteur voisin,
						faute de facteur exact dans la base.
					</p>

					<div class="tableau-defilant">
						<table class="facteurs">
							<thead>
								<tr>
									<th scope="col">Matériau</th>
									<th scope="col">Valeur</th>
									<th scope="col">Incertitude</th>
									<th scope="col">Élément ADEME</th>
								</tr>
							</thead>
							<tbody>
								{
									facteurs.categories.map((c) => (
										<>
											<tr class="ligne-categorie">
												<th scope="rowgroup" colspan="4">
													{c.libelle}
												</th>
											</tr>
											{c.sous.map((s) => (
												<tr>
													<th scope="row">
														{s.libelle}
														{s.approche && <span class="marque">approché</span>}
													</th>
													<td>{s.valeur.toLocaleString('fr-FR')} kgCO2e/tonne</td>
													<td>{s.incertitude_pct} %</td>
													<td>
														n° {s.identifiant_ademe}
														<span class="intitule">{s.intitule_ademe}</span>
													</td>
												</tr>
											))}
										</>
									))
								}
								<tr class="ligne-categorie">
									<th scope="rowgroup" colspan="4">Énergie, transport et comparaison</th>
								</tr>
								<tr>
									<th scope="row">Électricité</th>
									<td>{facteurs.energie.valeur} {facteurs.energie.unite}</td>
									<td>{facteurs.energie.incertitude_pct} %</td>
									<td>
										n° {facteurs.energie.identifiant_ademe}
										<span class="intitule">{facteurs.energie.intitule_ademe}</span>
									</td>
								</tr>
								<tr>
									<th scope="row">Transport</th>
									<td>{facteurs.transport.valeur} {facteurs.transport.unite}</td>
									<td>{facteurs.transport.incertitude_pct} %</td>
									<td>
										n° {facteurs.transport.identifiant_ademe}
										<span class="intitule">{facteurs.transport.intitule_ademe}</span>
									</td>
								</tr>
								{
									facteurs.comparaisons.map((c) => (
										<tr>
											<th scope="row">{c.libelle}</th>
											<td>
												{c.valeur} {c.unite}
											</td>
											<td>{c.incertitude_pct} %</td>
											<td>
												n° {c.identifiant_ademe}
												<span class="intitule">{c.intitule_ademe}</span>
											</td>
										</tr>
									))
								}
							</tbody>
						</table>
					</div>

					<p class="avertissement">
						<strong>Fin de vie : poste non chiffré.</strong> {facteurs.fin_de_vie.remarque}
					</p>
				</div>
			</details>
		</div>
	</section>
</Base>

<style>
	.entete {
		max-width: 46rem;
	}
	.fil {
		font-size: 0.9rem;
		color: var(--gris-leger);
		margin-bottom: 1.25rem;
	}
	.surtitre {
		font-family: var(--titres);
		font-weight: 500;
		color: var(--bleu);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.85rem;
		margin-bottom: 0.75rem;
	}
	.chapeau {
		font-size: 1.15rem;
	}
	/* Aligné sur le simulateur au-dessus (pleine largeur) : un conteneur plus étroit se
	   centrerait et paraîtrait décalé. Ce sont les paragraphes qui gardent une longueur de
	   ligne confortable, pas le conteneur. */
	.methodologie__corps p,
	.methodologie__corps li {
		max-width: var(--mesure);
	}

	/* La méthodologie est repliée : elle intéresse qui veut vérifier, pas qui veut estimer. */
	.methodologie summary {
		cursor: pointer;
		font-family: var(--titres);
		font-weight: 600;
		font-size: 1.15rem;
		color: var(--bleu-nuit);
		list-style: none;
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}
	.methodologie summary::-webkit-details-marker {
		display: none;
	}
	.methodologie summary::before {
		content: '';
		width: 0.55rem;
		height: 0.55rem;
		border-right: 2px solid var(--bleu);
		border-bottom: 2px solid var(--bleu);
		transform: rotate(-45deg);
		transition: transform 0.2s;
		flex: 0 0 auto;
	}
	.methodologie[open] summary::before {
		transform: rotate(45deg);
	}
	.methodologie__corps {
		padding-top: 1.5rem;
	}
	.methodologie h2 {
		font-size: 1.2rem;
		margin-top: 2rem;
	}
	.methodologie h2:first-child {
		margin-top: 0;
	}
	.methodologie ul {
		padding-left: 1.3rem;
	}
	.methodologie li {
		margin-bottom: 0.5rem;
	}
	.avertissement {
		margin-top: 1.5rem;
		padding: 1rem 1.25rem;
		background: var(--blanc);
		border-left: 3px solid var(--orange);
	}

	.tableau-defilant {
		overflow-x: auto;
	}
	.facteurs {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.9rem;
		margin: 1.5rem 0;
		min-width: 34rem;
	}
	.facteurs th,
	.facteurs td {
		text-align: left;
		padding: 0.6rem 1rem 0.6rem 0;
		border-bottom: 1px solid var(--gris-moyen);
		vertical-align: top;
	}
	.facteurs thead th {
		font-family: var(--titres);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		font-size: 0.72rem;
		color: var(--gris-leger);
		border-bottom: 2px solid var(--bleu-nuit);
	}
	.facteurs tbody th {
		font-weight: 600;
		color: var(--bleu-nuit);
	}
	.ligne-categorie th {
		font-family: var(--titres);
		text-transform: uppercase;
		letter-spacing: 0.07em;
		font-size: 0.72rem;
		color: var(--bleu);
		padding-top: 1.25rem;
		border-bottom: 1px solid var(--bleu-clair);
	}
	.intitule {
		display: block;
		font-size: 0.82rem;
		color: var(--gris-leger);
		font-weight: 400;
	}
	.marque {
		display: inline-block;
		margin-left: 0.35rem;
		font-size: 0.68rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--gris-leger);
		border: 1px solid var(--gris-moyen);
		border-radius: 2px;
		padding: 0 0.25rem;
		font-weight: 400;
		vertical-align: middle;
	}
</style>
