---
// Module « Simulateur d'empreinte carbone ».
//
// La page reste non indexée tant que les ratios de calage sur machines livrées ne sont pas
// fournis : publier un chiffre non calé engagerait l'entreprise.
//
// Aucun qualificatif environnemental n'est employé ici (« bas carbone », « vert »,
// « neutre »…) : la directive (UE) 2024/825 s'applique depuis le 27 septembre 2026.
import Base from '../../layouts/Base.astro';
import SimulateurCarbone from '../../components/modules/SimulateurCarbone.astro';
import facteurs from '../../../content/donnees/facteurs-carbone.json';

const approches = facteurs.categories.flatMap((c) => c.sous).filter((s) => s.approche);
---

<Base
	titre="Simulateur d’empreinte carbone"
	description="Ordre de grandeur des émissions d’une machine spéciale sur son cycle de vie."
	noindex={true}
>
	<section class="bloc bloc--blanc">
		<div class="bloc__interieur entete">
			<p class="fil"><a href="/">Accueil</a> <span aria-hidden="true">›</span> Outils</p>
			<p class="surtitre">Outil en préparation</p>
			<h1>Quelle sera l’empreinte carbone de votre machine ?</h1>
			<p class="chapeau">
				<span class="a-rediger">[à relire]</span> Renseignez ce que vous savez de la machine, même
				grossièrement, puis affinez ce que vous connaissez précisément.
			</p>
		</div>
	</section>

	<section class="bloc bloc--blanc">
		<div class="bloc__interieur">
			<SimulateurCarbone />
		</div>
	</section>

	<section class="bloc bloc--clair">
		<div class="bloc__interieur methode">
			<h2>Comment il procède</h2>
			<ul>
				<li>
					<strong>Fabrication</strong> : masse de chaque famille de matériaux, multipliée par son
					facteur d’émission.
				</li>
				<li>
					<strong>Transport</strong> : masse totale multipliée par la distance de livraison et par
					le facteur du transport routier. Seule la livraison de la machine terminée est comptée.
				</li>
				<li>
					<strong>Usage</strong> : puissance installée, taux de charge, heures par an et durée de
					vie donnent une consommation, multipliée par le facteur du mix électrique français.
					L’outil ne vaut donc que pour un usage en France continentale.
				</li>
				<li><strong>Fin de vie</strong> : non chiffrée, et donc absente du total.</li>
			</ul>
			<p>
				Une catégorie renseignée sans détail est bornée par son matériau le moins émetteur et par
				le plus émetteur. La fourchette est alors large, et se resserre dès qu’on détaille :
				c’est voulu, l’imprécision de la saisie doit se voir dans le résultat.
			</p>
			<p>Le calcul se fait dans votre navigateur : rien de ce que vous saisissez ne nous parvient.</p>

			<h2>Les facteurs d’émission employés</h2>
			<p>
				Tous proviennent de la <strong>Base Empreinte de l’ADEME</strong>, relevés le
				{facteurs.date_releve.split('-').reverse().join('/')}. Chaque ligne porte son identifiant
				d’élément, sa valeur et l’incertitude officielle publiée avec elle. Aucune valeur n’est
				estimée.
			</p>

			<table class="facteurs">
				<thead>
					<tr>
						<th scope="col">Matériau</th>
						<th scope="col">Valeur</th>
						<th scope="col">Incertitude</th>
						<th scope="col">Élément ADEME</th>
					</tr>
				</thead>
				<tbody>
					{
						facteurs.categories.map((c) => (
							<>
								<tr class="ligne-categorie">
									<th scope="rowgroup" colspan="4">
										{c.libelle}
									</th>
								</tr>
								{c.sous.map((s) => (
									<tr>
										<th scope="row">
											{s.libelle}
											{s.approche && <span class="marque">approché</span>}
										</th>
										<td>{s.valeur.toLocaleString('fr-FR')} kgCO2e/tonne</td>
										<td>{s.incertitude_pct} %</td>
										<td>
											n° {s.identifiant_ademe}
											<span class="intitule">{s.intitule_ademe}</span>
										</td>
									</tr>
								))}
							</>
						))
					}
					<tr class="ligne-categorie">
						<th scope="rowgroup" colspan="4">Énergie, transport et repères de comparaison</th>
					</tr>
					<tr>
						<th scope="row">Électricité</th>
						<td>{facteurs.energie.valeur} {facteurs.energie.unite}</td>
						<td>{facteurs.energie.incertitude_pct} %</td>
						<td>
							n° {facteurs.energie.identifiant_ademe}
							<span class="intitule">{facteurs.energie.intitule_ademe}</span>
						</td>
					</tr>
					<tr>
						<th scope="row">Transport</th>
						<td>{facteurs.transport.valeur} {facteurs.transport.unite}</td>
						<td>{facteurs.transport.incertitude_pct} %</td>
						<td>
							n° {facteurs.transport.identifiant_ademe}
							<span class="intitule">{facteurs.transport.intitule_ademe}</span>
						</td>
					</tr>
					{
						facteurs.comparaisons.map((c) => (
							<tr>
								<th scope="row">{c.libelle}</th>
								<td>{c.valeur} {c.unite}</td>
								<td>{c.incertitude_pct} %</td>
								<td>
									n° {c.identifiant_ademe}
									<span class="intitule">{c.intitule_ademe}</span>
								</td>
							</tr>
						))
					}
				</tbody>
			</table>

			<p class="avertissement">
				<strong>Fin de vie : poste non chiffré.</strong> {facteurs.fin_de_vie.remarque}
			</p>

			<h2>Les approximations, à lever</h2>
			<ul>
				{
					approches.map((s) => (
						<li>
							<strong>{s.libelle}</strong> — {s.remarque}
						</li>
					))
				}
			</ul>
			<p>
				Les déclarations <strong>PEP ecopassport</strong> donneraient des facteurs propres aux
				composants électriques réellement montés. Elles restent à dépouiller.
			</p>
		</div>
	</section>

	<section class="bloc bloc--blanc">
		<div class="bloc__interieur methode">
			<h2>Ce qui manque avant la mise en ligne publique</h2>
			<ol>
				<li>
					<span class="a-rediger">[À FOURNIR PAR AUTOMACHINE]</span> les ratios de calage sur des
					machines réellement livrées. Sans eux, la fourchette est cohérente mais invérifiable.
				</li>
				<li>
					<span class="a-rediger">[À DÉPOUILLER]</span> les déclarations PEP ecopassport, pour
					remplacer le facteur approché de l’armoire électrique par des facteurs propres.
				</li>
				<li>
					<span class="a-rediger">[À TRANCHER]</span> le sort de la fin de vie : la laisser hors du
					total, ou retenir une hypothèse et l’assumer comme telle.
				</li>
			</ol>
			<p class="avertissement">
				Tant que ces trois points ne sont pas réglés, cette page reste à l’écart des moteurs de
				recherche.
			</p>
		</div>
	</section>

</Base>

<style>
	.entete {
		max-width: 46rem;
	}
	.fil {
		font-size: 0.9rem;
		color: var(--gris-leger);
		margin-bottom: 1.25rem;
	}
	.surtitre {
		font-family: var(--titres);
		font-weight: 500;
		color: var(--bleu);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.85rem;
		margin-bottom: 0.75rem;
	}
	.chapeau {
		font-size: 1.15rem;
	}
	.methode {
		max-width: 48rem;
	}
	.methode h2 {
		font-size: clamp(1.3rem, 3vw, 1.7rem);
		margin-top: 2.5rem;
	}
	.methode h2:first-child {
		margin-top: 0;
	}
	.methode ul,
	.methode ol {
		padding-left: 1.3rem;
	}
	.methode li {
		margin-bottom: 0.5rem;
	}
	.avertissement {
		margin-top: 1.5rem;
		padding: 1rem 1.25rem;
		background: var(--blanc);
		border-left: 3px solid var(--orange);
	}
	.facteurs {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.9rem;
		margin: 1.5rem 0;
	}
	.facteurs th,
	.facteurs td {
		text-align: left;
		padding: 0.6rem 1rem 0.6rem 0;
		border-bottom: 1px solid var(--gris-moyen);
		vertical-align: top;
	}
	.facteurs thead th {
		font-family: var(--titres);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		font-size: 0.72rem;
		color: var(--gris-leger);
		border-bottom: 2px solid var(--bleu-nuit);
	}
	.facteurs tbody th {
		font-weight: 600;
		color: var(--bleu-nuit);
	}
	.ligne-categorie th {
		font-family: var(--titres);
		text-transform: uppercase;
		letter-spacing: 0.07em;
		font-size: 0.72rem;
		color: var(--bleu);
		padding-top: 1.25rem;
		border-bottom: 1px solid var(--bleu-clair);
	}
	.intitule {
		display: block;
		font-size: 0.82rem;
		color: var(--gris-leger);
		font-weight: 400;
	}
	.marque {
		display: inline-block;
		margin-left: 0.35rem;
		font-size: 0.68rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--gris-leger);
		border: 1px solid var(--gris-moyen);
		border-radius: 2px;
		padding: 0 0.25rem;
		font-weight: 400;
		vertical-align: middle;
	}
	.appel {
		max-width: 42rem;
		text-align: center;
	}
	.appel p {
		margin-left: auto;
		margin-right: auto;
	}
</style>
