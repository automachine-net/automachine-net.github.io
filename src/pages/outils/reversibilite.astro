---
// Module « Réversibilité » — emplacement et fil conducteur.
//
// Le scénario interactif reste à construire avec le dirigeant. La page pose les trois idées
// et réserve la place de l'animation. Non indexée tant qu'elle n'a pas de contenu propre.
import Base from '../../layouts/Base.astro';
---

<Base
	titre="Le principe de réversibilité"
	description="Réverser, c’est ramener à l’état antérieur. Une transformation est réversible si on peut l’annuler."
	noindex={true}
>
	<section class="bloc bloc--blanc">
		<div class="bloc__interieur entete">
			<p class="fil"><a href="/">Accueil</a> <span aria-hidden="true">›</span> Outils</p>
			<p class="surtitre">Outil en préparation</p>
			<h1>Une transformation est réversible si on peut l’annuler</h1>
			<p class="chapeau">
				<span class="a-rediger">[à relire]</span> Réverser, c’est ramener à l’état antérieur.
				L’idée est simple à énoncer et difficile à appliquer à une machine. Cet outil servira à
				la manipuler plutôt qu’à la lire.
			</p>
		</div>
	</section>

	<section class="bloc bloc--clair">
		<div class="bloc__interieur fil-conducteur">
			<h2>Le fil conducteur</h2>
			<ol class="etapes">
				<li>
					<h3>Réverser</h3>
					<p>Ramener à l’état antérieur.</p>
				</li>
				<li>
					<h3>Réversible</h3>
					<p>Une transformation est réversible si on peut l’annuler.</p>
				</li>
				<li>
					<h3>Deux critères pour juger un choix de conception</h3>
					<p>
						Des émissions inférieures ou égales à ce que la biosphère peut réverser. Et une
						matière préservée, apte au même usage après usage.
					</p>
				</li>
			</ol>
		</div>
	</section>

	<section class="bloc bloc--blanc">
		<div class="bloc__interieur fil-conducteur">
			<h2>Ce qui reste à construire</h2>
			<div class="visuel visuel--module">
				<span>[ANIMATION À CONSTRUIRE ENSEMBLE] scénario interactif du principe de réversibilité</span>
			</div>
			<p>
				<span class="a-rediger">[À DÉCIDER ENSEMBLE]</span> ce que le visiteur manipule, sur quel
				exemple, et ce qu’il doit avoir compris à la fin. Tant que ce point n’est pas tranché,
				la page reste à l’écart des moteurs de recherche.
			</p>
		</div>
	</section>
</Base>

<style>
	.entete {
		max-width: 46rem;
	}
	.fil {
		font-size: 0.9rem;
		color: var(--gris-leger);
		margin-bottom: 1.25rem;
	}
	.surtitre {
		font-family: var(--titres);
		font-weight: 500;
		color: var(--bleu);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.85rem;
		margin-bottom: 0.75rem;
	}
	.chapeau {
		font-size: 1.15rem;
	}
	.fil-conducteur {
		max-width: 46rem;
	}
	.etapes {
		list-style: none;
		padding: 0;
		margin: 0;
		counter-reset: etape;
		display: grid;
		gap: 1.75rem;
	}
	.etapes li {
		counter-increment: etape;
		display: grid;
		grid-template-columns: 2.5rem minmax(0, 1fr);
		gap: 0 1rem;
	}
	.etapes li::before {
		content: counter(etape);
		grid-row: 1 / 3;
		font-family: var(--titres);
		font-weight: 700;
		font-size: 1.8rem;
		color: var(--bleu-clair);
		line-height: 1;
	}
	.etapes h3 {
		margin: 0 0 0.25rem;
		font-size: 1.2rem;
	}
	.etapes p {
		margin: 0;
	}
	.visuel--module {
		height: clamp(9rem, 18vw, 13rem);
		margin: 1.5rem 0;
	}
</style>
