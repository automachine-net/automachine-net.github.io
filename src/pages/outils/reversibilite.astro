---
// Module « Réversibilité » — emplacement et fil conducteur.
//
// La page pose le fil conducteur, puis le module « Boucle ou hélice » que le dirigeant
// manipule en conférence.
import Base from '../../layouts/Base.astro';
import EntetePage from '../../components/EntetePage.astro';
import BoucleHelice from '../../components/modules/BoucleHelice.astro';
---

<Base
	titre="Le principe de réversibilité"
	description="Réverser, c’est ramener à l’état antérieur. Une transformation est réversible si on peut l’annuler."
>
	<EntetePage
		fil={[{ libelle: 'Accueil', href: '/' }, { libelle: 'Outils' }]}
		surtitre="Outil"
		titre="Une transformation est réversible si on peut l’annuler"
		chapeau="Réverser, c’est ramener à l’état antérieur. L’idée est simple à énoncer et difficile à appliquer à une machine. Cet outil sert à la manipuler plutôt qu’à la lire."
	/>

	<section class="bloc bloc--clair">
		<div class="bloc__interieur fil-conducteur">
			<h2>Le fil conducteur</h2>
			<ol class="etapes">
				<li>
					<h3>Réverser</h3>
					<p>Ramener à l’état antérieur.</p>
				</li>
				<li>
					<h3>Réversible</h3>
					<p>Une transformation est réversible si on peut l’annuler.</p>
				</li>
				<li>
					<h3>Deux critères pour juger un choix de conception</h3>
					<p>
						Des émissions inférieures ou égales à ce que la biosphère peut réverser. Et une matière
						préservée, apte au même usage après usage.
					</p>
				</li>
			</ol>
		</div>
	</section>

	<section class="bloc bloc--blanc">
		<div class="bloc__interieur">
			<BoucleHelice />
		</div>
	</section>
</Base>

<style>
	.fil-conducteur {
		max-width: 46rem;
	}
	.etapes {
		list-style: none;
		padding: 0;
		margin: 0;
		counter-reset: etape;
		display: grid;
		gap: 1.75rem;
	}
	.etapes li {
		counter-increment: etape;
		display: grid;
		grid-template-columns: 2.5rem minmax(0, 1fr);
		gap: 0 1rem;
	}
	.etapes li::before {
		content: counter(etape);
		grid-row: 1 / 3;
		font-family: var(--titres);
		font-weight: 700;
		font-size: 1.8rem;
		color: var(--bleu-clair);
		line-height: 1;
	}
	.etapes h3 {
		margin: 0 0 0.25rem;
		font-size: 1.2rem;
	}
	.etapes p {
		margin: 0;
	}
	.note {
		font-size: 0.9rem;
		color: var(--gris-leger);
		margin: 0 0 1rem;
	}
	.note code {
		font-size: 0.85em;
	}
</style>
