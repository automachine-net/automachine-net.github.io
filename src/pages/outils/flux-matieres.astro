---
// Module « Circulation des matières » : le schéma de flux animé, étape par étape.
//
// Premier des modules pensés pour la conférence sur la réversibilité : le dirigeant le
// pilote au clavier pendant son exposé, et le visiteur du site le parcourt à son rythme.
import Base from '../../layouts/Base.astro';
import EntetePage from '../../components/EntetePage.astro';
import FluxMatieres from '../../components/modules/FluxMatieres.astro';
---

<Base
	titre="Où va la matière ?"
	description="Ce qui entre chaque année dans l’économie française, ce qui en ressort, ce qui est perdu et ce qui est recyclé. Un schéma de flux animé, étape par étape."
>
	<EntetePage
		fil={[{ libelle: 'Accueil', href: '/' }, { libelle: 'Outils' }]}
		surtitre="Outil"
		titre="Où va la matière ?"
		chapeau="Près d’un milliard de tonnes de matières entrent chaque année dans l’économie française. Une petite part en ressort recyclée. Le reste s’accumule, repart à l’export, ou se perd. Suivez le chemin, étape par étape."
	/>

	<section class="bloc bloc--clair">
		<div class="bloc__interieur">
			<FluxMatieres />
		</div>
	</section>
</Base>
