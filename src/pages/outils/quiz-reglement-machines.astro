---
// Module « Quiz règlement machines », parcours professionnel.
// Les questions vivent dans content/quiz/reglement-machines.json, éditable dans le CMS.
import Base from '../../layouts/Base.astro';
import EntetePage from '../../components/EntetePage.astro';
import CompteARebours from '../../components/modules/CompteARebours.astro';
import QuizComplet from '../../components/modules/QuizComplet.astro';
---

<Base
	titre="Quiz règlement machines"
	description="Le règlement (UE) 2023/1230 remplace la directive 2006/42/CE le 20 janvier 2027. Testez vos réflexes, thème par thème, avec l'explication et la référence d'article à chaque réponse."
>
	<EntetePage
		fil={[{ libelle: 'Accueil', href: '/' }, { libelle: 'Outils' }]}
		surtitre="Outil"
		titre="Le règlement machines change le 20 janvier 2027"
		chapeau="Le règlement (UE) 2023/1230 remplace la directive 2006/42/CE. Il change ce qui doit figurer dans votre dossier technique, qui porte la responsabilité, et comment se déroule l’évaluation de conformité. Choisissez un thème, répondez, et lisez l’explication : chaque réponse renvoie à l’article correspondant."
	/>

	<section class="bloc bloc--blanc">
		<div class="bloc__interieur">
			<CompteARebours />
		</div>
	</section>

	<section class="bloc bloc--blanc">
		<div class="bloc__interieur">
			<QuizComplet />
		</div>
	</section>

	<section class="bloc bloc--sombre">
		<div class="bloc__interieur appel">
			<h2>Une machine à concevoir dans ce cadre ?</h2>
			<p>
				Nous concevons et fabriquons des machines spéciales, dossier de conformité compris.
				Décrivez-nous votre besoin.
			</p>
			<p><a class="bouton bouton--clair" href="/contact">Nous contacter</a></p>
		</div>
	</section>
</Base>

<style>
	.appel {
		max-width: 42rem;
		text-align: center;
	}
	.appel p {
		margin-left: auto;
		margin-right: auto;
	}
</style>
