---
import { getEntry, render } from 'astro:content';

const page = await getEntry('pages', 'accueil');
if (!page) throw new Error('content/pages/accueil.md est introuvable');
const { Content } = await render(page);
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="generator" content={Astro.generator} />
		<title>{page.data.titre} — site en construction</title>
		<style>
			body {
				margin: 0;
				min-height: 100vh;
				display: grid;
				place-items: center;
				font-family: system-ui, sans-serif;
				color: #56514f;
				background: #fff;
			}
			main {
				text-align: center;
				padding: 2rem;
			}
			h1 {
				color: #53769a;
				font-weight: 600;
			}
		</style>
	</head>
	<body>
		<main>
			<h1>{page.data.titre}</h1>
			<Content />
		</main>
	</body>
</html>
