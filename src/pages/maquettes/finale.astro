---
// Maquette finale — v2, après les retours du 2 septembre 2026.
// Changements : variante 2 retenue pour les machines (cartes à faire défiler), section
// « Ce que fait la machine » retirée, plus de bloc parapluie « Outils » (un bloc par outil,
// titré par ce qu'il fait), textes parasites supprimés, section Secteurs remplacée par
// une bande de clients.
import Maquette from '../../layouts/Maquette.astro';
import IconeSecteur from '../../components/IconeSecteur.astro';
import { navigation, machines, secteurs, clients, chiffres, dateReglement } from '../../data/maquette';
import quiz from '../../../content/quiz/reglement-machines.json';

const sommaire = [
	{ id: 'machines', num: '1', label: 'Machines' },
	{ id: 'reglement', num: '2', label: 'Règlement 2027' },
	{ id: 'carbone', num: '3', label: 'Empreinte carbone' },
	{ id: 'budget', num: '4', label: 'Ordre de prix' },
	{ id: 'reversibilite', num: '5', label: 'Réversibilité' },
	{ id: 'clients', num: '6', label: 'Clients' },
	{ id: 'entreprise', num: '7', label: 'Entreprise' },
	{ id: 'contact', num: '8', label: 'Contact' },
];

// Trois questions courtes, de thèmes différents, prises dans le vrai jeu de 64.
const questionsAccueil = [1, 21, 56].map((id) => quiz.questions.find((q) => q.id === id)!);
const lettres = ['a', 'b', 'c', 'd'] as const;
const article = (r: string) => r.replace(/^art\.\s*/i, 'article ');
---

<Maquette titre="Maquette finale">
	<a class="evitement" href="#contenu">Aller au contenu</a>

	<header class="entete">
		<a href="/" class="marque" aria-label="Automachine, accueil">
			<img src="/images/logo/avec-texte.svg" alt="Automachine, machines spéciales" width="157" height="59" />
		</a>
		<nav aria-label="Navigation principale">
			<ul>
				{navigation.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
			</ul>
		</nav>
	</header>

	<div class="page">
		<aside class="sommaire">
			<p class="sommaire__titre">Sommaire</p>
			<ol>
				{sommaire.map((s) => <li><a href={`#${s.id}`}><span class="num">{s.num}</span>{s.label}</a></li>)}
			</ol>
		</aside>

		<main id="contenu">
			<section class="ouverture">
				<p class="surtitre">Conception et fabrication de machines spéciales</p>
				<h1><span class="a-rediger">[À RÉDIGER]</span> une phrase courte, au présent.</h1>
				<p class="chapeau">
					<span class="a-rediger">[À RÉDIGER]</span> deux phrases : le besoin, la méthode, ce que reçoit
					le client. Pour l’industrie, l’agriculture, la recherche, les bancs de test et le tertiaire.
				</p>
				<ul class="secteurs" aria-label="Secteurs pris en charge">
					{
						secteurs.map((s) => (
							<li>
								<IconeSecteur secteur={s.slug} />
								<span>{s.nom}</span>
							</li>
						))
					}
				</ul>
				<p class="actions"><a class="bouton" href="/contact">Décrire un besoin</a></p>
			</section>

			<!-- 1. Machines : cartes indépendantes, chacune avec son volume manipulable -->
			<section class="partie" id="machines">
				<header class="partie__tete">
					<span class="num">1</span>
					<h2>Machines</h2>
				</header>
				<ul class="cartes" data-cartes>
					{
						machines.map((m, i) => (
							<li class="carte">
								<canvas width="480" height="340" data-slug={m.slug} tabindex="0" aria-label={`Volume 3D : ${m.nom}`}></canvas>
								<div class="carte__corps">
									<p class="carte__index">{String(i + 1).padStart(2, '0')} · {m.secteur}</p>
									<h3><a href={`/machines/${m.slug}`}>{m.nom}</a></h3>
									<p class="a-rediger carte__fonction">[À RÉDIGER] ce que fait la machine, en une ligne.</p>
								</div>
							</li>
						))
					}
				</ul>
				<p class="apres"><a href="/machines">Toutes les machines</a></p>
			</section>

			<!-- 2. Outil : quiz règlement -->
			<section class="partie outil" id="reglement">
				<header class="partie__tete">
					<span class="num">2</span>
					<h2>Serez-vous prêt le 20 janvier 2027 ?</h2>
					<p class="partie__note">
						Le règlement (UE) 2023/1230 remplace la directive 2006/42/CE. Il reste
						<strong><span data-echeance={dateReglement}> <span data-jours>—</span> jours</span></strong> pour s’y préparer.
					</p>
				</header>

				<div class="quiz" data-quiz>
					<ol class="quiz__liste">
						{
							questionsAccueil.map((q) => (
								<li class="question" data-bonne={q.bonne_reponse}>
									<p class="question__texte">{q.question}</p>
									<div class="question__options" role="group" aria-label="Réponses">
										{lettres.map((l) => (
											<button type="button" class="option" data-lettre={l}>
												<span class="option__lettre">{l.toUpperCase()}</span>
												<span>{q.options[l]}</span>
											</button>
										))}
									</div>
									<p class="question__explication" hidden>
										<strong data-verdict></strong> {q.explication}
										<span class="reference">Règlement (UE) 2023/1230, {article(q.reference)}.</span>
									</p>
								</li>
							))
						}
					</ol>
					<p class="quiz__pied">
						<a class="bouton" href="/outils/quiz-reglement-machines">Continuer</a>
						<span class="note">{quiz.mention}</span>
					</p>
				</div>
			</section>

			<!-- 3. Outil : empreinte carbone -->
			<section class="partie outil" id="carbone">
				<header class="partie__tete">
					<span class="num">3</span>
					<h2>Quelle sera l’empreinte carbone de votre machine ?</h2>
					<p class="partie__note">
						Une fourchette, à partir de la masse, des matériaux, de la puissance installée et de la durée de vie.
					</p>
				</header>
				<div class="apercu">
					<div class="apercu__champs">
						<label>Masse totale <span class="unite">kg</span><input type="number" value="1200" disabled /></label>
						<label>Puissance installée <span class="unite">kW</span><input type="number" value="15" disabled /></label>
						<label>Heures par an <span class="unite">h</span><input type="number" value="2000" disabled /></label>
						<label>Durée de vie <span class="unite">ans</span><input type="number" value="15" disabled /></label>
					</div>
					<div class="apercu__sortie">
						<p class="apercu__legende">Résultat, en fourchette</p>
						<div class="barre">
							<span class="barre__seg barre__seg--fab" style="--part: 34">Fabrication</span>
							<span class="barre__seg barre__seg--tra" style="--part: 6">Transport</span>
							<span class="barre__seg barre__seg--usa" style="--part: 52">Usage</span>
							<span class="barre__seg barre__seg--fin" style="--part: 8">Fin de vie</span>
						</div>
						<p class="a-rediger">[VALEURS À CALER] les facteurs d’émission (Base Empreinte ADEME, PEP ecopassport) et les ratios sur machines livrées restent à fournir. Les proportions ci-dessus n’ont aucune valeur, elles montrent la forme du résultat.</p>
					</div>
				</div>
				<p class="apres"><a href="/outils/simulateur-carbone">Ouvrir le simulateur</a></p>
			</section>

			<!-- 4. Outil : ordre de prix -->
			<section class="partie outil" id="budget">
				<header class="partie__tete">
					<span class="num">4</span>
					<h2>Combien coûte une machine comme la vôtre ?</h2>
					<p class="partie__note">Un ordre de grandeur en quelques questions, avant même de nous appeler.</p>
				</header>
				<div class="visuel visuel--module">
					<span>
						[MODULE À DÉFINIR ENSEMBLE] pistes d’entrées évoquées : encombrement de la machine,
						nombre de robots, niveau de sécurité demandé. Méthode, bornes et avertissements à arrêter
						avant toute mise en ligne.
					</span>
				</div>
			</section>

			<!-- 5. Outil : réversibilité -->
			<section class="partie outil" id="reversibilite">
				<header class="partie__tete">
					<span class="num">5</span>
					<h2>Une transformation est réversible si on peut l’annuler</h2>
					<p class="partie__note">Réverser, c’est ramener à l’état antérieur.</p>
				</header>
				<div class="deux">
					<ol class="criteres">
						<li>Des émissions inférieures ou égales à ce que la biosphère peut réverser.</li>
						<li>Une matière préservée, apte au même usage après usage.</li>
					</ol>
					<div class="visuel visuel--module">
						<span>[MODULE À CONSTRUIRE ENSEMBLE] animation interactive, scénario à écrire</span>
					</div>
				</div>
			</section>

			<!-- 6. Clients -->
			<section class="partie" id="clients">
				<header class="partie__tete">
					<span class="num">6</span>
					<h2>Ils nous ont fait confiance</h2>
				</header>
				<ul class="clients">
					{
						clients.map((c) => (
							<li>
								<img src={c.logo} alt={c.nom} width="200" height="200" loading="lazy" />
							</li>
						))
					}
				</ul>
			</section>

			<!-- 7. Entreprise -->
			<section class="partie partie--sombre" id="entreprise">
				<div class="partie--sombre__interieur">
					<header class="partie__tete">
						<span class="num">7</span>
						<h2>Entreprise</h2>
					</header>
					<div class="deux">
						<div>
							<p>
								<span class="a-rediger">[À RÉDIGER]</span> 2011, création de Sourcitem. 2017, l’entreprise
								devient Automachine. Équipe, valeurs, certifications
								<span class="a-rediger">[À CONFIRMER : ISO 9001, ISO 14001]</span>.
							</p>
							<p><a class="lien-clair" href="/entreprise">Découvrir l’entreprise</a></p>
						</div>
						<dl class="chiffres">
							{chiffres.map((c) => (
								<div>
									<dt class={c.valeur.startsWith('[') ? 'a-rediger' : ''}>{c.valeur}</dt>
									<dd>{c.legende}</dd>
								</div>
							))}
						</dl>
					</div>
				</div>
			</section>

			<!-- 8. Contact -->
			<section class="partie partie--contact" id="contact">
				<header class="partie__tete">
					<span class="num">8</span>
					<h2>Un besoin de machine ?</h2>
				</header>
				<p><span class="a-rediger">[À RÉDIGER]</span> comment se passe un premier échange.</p>
				<p><a class="bouton" href="/contact">Nous contacter</a></p>
			</section>
		</main>
	</div>

	<footer class="pied">
		<p>Automachine — <span class="a-rediger">[À RÉDIGER] adresse, téléphone</span></p>
		<ul>
			<li><a href="/mentions-legales">Mentions légales</a></li>
			<li><a href="/confidentialite">Confidentialité</a></li>
		</ul>
	</footer>

	<script>
		import { modeles, monterScene } from '../../scripts/filaire';

		// Une scène par carte machine. Rotation lente continue, arrêtée dès que le volume sort
		// de l'écran et pour les visiteurs qui demandent moins d'animation.
		document.querySelectorAll<HTMLCanvasElement>('[data-cartes] canvas').forEach((c) => {
			const m = modeles.find((x) => x.slug === c.dataset.slug);
			if (m) monterScene(c, m, { echelle: 0.2, trait: 1.5 });
		});

		// Compte à rebours.
		for (const el of document.querySelectorAll<HTMLElement>('[data-echeance]')) {
			const jours = Math.ceil((new Date(el.dataset.echeance + 'T00:00:00').getTime() - Date.now()) / 86_400_000);
			const s = el.querySelector('[data-jours]');
			if (s && jours > 0) s.textContent = String(jours);
		}

		// Quiz : retour immédiat coloré au clic.
		document.querySelectorAll<HTMLElement>('[data-quiz] .question').forEach((q) => {
			const bonne = q.dataset.bonne;
			const options = q.querySelectorAll<HTMLButtonElement>('.option');
			const expl = q.querySelector<HTMLElement>('.question__explication')!;
			const verdict = expl.querySelector<HTMLElement>('[data-verdict]')!;
			options.forEach((o) => o.addEventListener('click', () => {
				if (q.classList.contains('repondue')) return;
				q.classList.add('repondue');
				const juste = o.dataset.lettre === bonne;
				options.forEach((x) => {
					x.disabled = true;
					if (x.dataset.lettre === bonne) x.classList.add('option--bonne');
					else if (x === o) x.classList.add('option--fausse');
				});
				verdict.textContent = juste ? 'Exact.' : `Non, la bonne réponse est ${bonne!.toUpperCase()}.`;
				expl.hidden = false;
			}));
		});

		// Sommaire : la partie visible est soulignée.
		const liens = [...document.querySelectorAll<HTMLAnchorElement>('.sommaire a')];
		const obs = new IntersectionObserver((entries) => {
			for (const e of entries) if (e.isIntersecting) liens.forEach((l) => l.classList.toggle('actif', l.hash === '#' + e.target.id));
		}, { rootMargin: '-35% 0px -55% 0px' });
		document.querySelectorAll('main > section[id]').forEach((p) => obs.observe(p));
	</script>
</Maquette>

<style>
	.evitement { position: absolute; left: -999px; top: 0; background: var(--bleu-nuit); color: var(--blanc); padding: 0.5rem 1rem; }
	.evitement:focus { left: 1rem; z-index: 10; }

	.entete {
		position: sticky; top: 0; z-index: 5; background: var(--blanc);
		display: flex; align-items: center; justify-content: space-between; gap: 2rem;
		padding: 0.75rem clamp(1rem, 4vw, 3rem); border-bottom: 2px solid var(--bleu-nuit);
	}
	.marque img { width: 104px; height: auto; }
	.entete nav ul { list-style: none; margin: 0; padding: 0; display: flex; gap: clamp(0.75rem, 2vw, 1.75rem); flex-wrap: wrap; }
	.entete nav a { text-decoration: none; color: var(--bleu-nuit); font-family: var(--titres); font-weight: 600; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.06em; }
	.entete nav a:hover { color: var(--bleu); }

	.page { display: grid; grid-template-columns: 11rem minmax(0, 1fr); gap: 2.5rem; padding: 0 clamp(1rem, 4vw, 3rem); max-width: 90rem; margin: 0 auto; }
	@media (max-width: 1000px) { .page { grid-template-columns: 1fr; gap: 0; } .sommaire { display: none; } }
	.sommaire { position: sticky; top: 5rem; align-self: start; padding: 2rem 0; font-size: 0.9rem; }
	.sommaire__titre { font-family: var(--titres); text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.75rem; color: var(--gris-leger); margin-bottom: 0.75rem; }
	.sommaire ol { list-style: none; margin: 0; padding: 0; }
	.sommaire a { display: flex; gap: 0.6rem; padding: 0.4rem 0; text-decoration: none; color: var(--gris); border-top: 1px solid var(--gris-moyen); }
	.sommaire a.actif { color: var(--bleu-nuit); font-weight: 600; }
	.sommaire a.actif .num { color: var(--orange); }
	.num { font-family: var(--titres); font-weight: 700; color: var(--bleu); }

	main { min-width: 0; }
	.ouverture { padding: clamp(2.5rem, 7vw, 5rem) 0 clamp(2rem, 5vw, 3rem); max-width: 44rem; }
	.ouverture h1 { font-size: clamp(2.25rem, 5vw, 3.5rem); }
	.surtitre { font-family: var(--titres); font-weight: 500; color: var(--bleu); text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.85rem; margin-bottom: 1rem; }
	.chapeau { font-size: 1.2rem; }
	.actions { margin-top: 1.75rem; }
	.bouton { display: inline-block; background: var(--bleu-nuit); color: var(--blanc); text-decoration: none; font-weight: 500; padding: 0.8rem 1.4rem; border-radius: var(--rayon); }
	.bouton:hover { background: var(--bleu); color: var(--blanc); }
	.note { font-size: 0.85rem; color: var(--gris-leger); }
	.apres { margin-top: 1.25rem; font-weight: 500; }

	.partie { padding: clamp(2.5rem, 6vw, 4rem) 0; border-bottom: 1px solid var(--gris-moyen); }
	.partie__tete { display: grid; grid-template-columns: 3rem minmax(0, 1fr); gap: 0 1rem; align-items: baseline; margin-bottom: 1.5rem; }
	.partie__tete .num { font-size: 2rem; grid-row: 1 / 3; }
	.partie__tete h2 { font-size: clamp(1.75rem, 4vw, 2.5rem); margin: 0; max-width: 22ch; }
	.partie__note { grid-column: 2; margin: 0.5rem 0 0; color: var(--gris-leger); font-size: 1rem; max-width: 60ch; }
	.partie__note strong { color: var(--bleu-nuit); }

	/* Machines : cartes à faire défiler */
	.cartes { list-style: none; margin: 0; padding: 0 0 1rem; display: flex; gap: 1rem; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: thin; }
	.carte { scroll-snap-align: start; flex: 0 0 min(21rem, 82vw); border: 1px solid var(--gris-moyen); border-radius: var(--rayon); background: var(--blanc); }
	.carte canvas { width: 100%; aspect-ratio: 480 / 340; background: var(--gris-clair); cursor: grab; touch-action: pan-x; border-bottom: 1px solid var(--gris-moyen); }
	.carte canvas.actif { cursor: grabbing; }
	.carte__corps { padding: 1rem 1.1rem 1.2rem; }
	.carte__index { font-family: var(--titres); color: var(--bleu); font-weight: 700; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; margin: 0; }
	.carte h3 { font-size: 1.3rem; margin: 0.15rem 0 0.4rem; }
	.carte h3 a { text-decoration: none; }
	.carte h3 a:hover { text-decoration: underline; }
	.carte__fonction { font-size: 0.95rem; margin: 0; }

	/* Quiz */
	.quiz__liste { list-style: none; padding: 0; margin: 0; display: grid; gap: 2.5rem; }
	.question__texte { font-size: 1.1rem; font-weight: 500; color: var(--bleu-nuit); max-width: 70ch; }
	.question__options { display: grid; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); gap: 0.6rem; }
	.option { display: grid; grid-template-columns: 1.75rem minmax(0, 1fr); gap: 0.6rem; align-items: start; text-align: left; background: var(--blanc); border: 1px solid var(--gris-moyen); border-radius: var(--rayon); padding: 0.7rem 0.9rem; cursor: pointer; color: var(--gris); line-height: 1.4; transition: border-color 0.15s, background 0.15s; }
	.option:hover:not(:disabled) { border-color: var(--bleu); }
	.option:disabled { cursor: default; }
	.option__lettre { font-family: var(--titres); font-weight: 700; color: var(--bleu); }
	.option--bonne { background: var(--bleu); border-color: var(--bleu); color: var(--blanc); }
	.option--bonne .option__lettre { color: var(--blanc); }
	.option--fausse { background: var(--orange); border-color: var(--orange); color: var(--bleu-nuit); }
	.option--fausse .option__lettre { color: var(--bleu-nuit); }
	.question__explication { margin: 0.9rem 0 0; padding: 0.9rem 1rem; background: var(--gris-clair); border-left: 3px solid var(--bleu); max-width: 75ch; }
	.reference { display: block; margin-top: 0.4rem; font-size: 0.85rem; color: var(--gris-leger); }
	.quiz__pied { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; align-items: center; margin: 2rem 0 0; max-width: none; }

	/* Aperçu du simulateur carbone */
	.apercu { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 2rem; align-items: start; }
	@media (max-width: 800px) { .apercu { grid-template-columns: 1fr; } }
	.apercu__champs { display: grid; gap: 0.75rem; }
	.apercu__champs label { display: grid; gap: 0.2rem; font-size: 0.9rem; font-weight: 500; color: var(--bleu-nuit); }
	.apercu__champs .unite { color: var(--gris-leger); font-weight: 400; }
	.apercu__champs input { font: inherit; padding: 0.5rem 0.7rem; border: 1px solid var(--gris-moyen); border-radius: var(--rayon); background: var(--gris-clair); color: var(--gris); }
	.apercu__legende { font-family: var(--titres); text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.75rem; color: var(--gris-leger); margin-bottom: 0.5rem; }
	.barre { display: flex; height: 3.5rem; border-radius: var(--rayon); overflow: hidden; font-size: 0.75rem; }
	.barre__seg { flex: 0 0 calc(var(--part) * 1%); display: grid; place-items: center; text-align: center; padding: 0 0.2rem; overflow: hidden; }
	.barre__seg--fab { background: var(--bleu-nuit); color: var(--blanc); }
	.barre__seg--tra { background: var(--bleu); color: var(--blanc); }
	.barre__seg--usa { background: var(--bleu-clair); color: var(--bleu-nuit); }
	.barre__seg--fin { background: var(--gris-moyen); color: var(--gris); }

	.visuel--module { aspect-ratio: 16 / 7; }
	.criteres { padding-left: 1.2rem; font-size: 1.05rem; }
	.criteres li { margin-bottom: 0.6rem; }

	/* Secteurs : bande de pictogrammes sous l'introduction */
	.secteurs { list-style: none; margin: 2rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 1.75rem 2.25rem; }
	.secteurs li { display: grid; justify-items: center; gap: 0.35rem; color: var(--bleu); width: 5.5rem; text-align: center; }
	.secteurs span { font-size: 0.8rem; font-weight: 500; color: var(--gris); line-height: 1.25; }

	/* Clients */
	.clients { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr)); gap: 1px; background: var(--gris-moyen); border: 1px solid var(--gris-moyen); }
	.clients li { background: var(--blanc); display: grid; place-items: center; min-height: 7rem; padding: 1rem; }
	/* Hauteur fixée : la place est réservée avant le chargement, la mise en page ne saute pas. */
