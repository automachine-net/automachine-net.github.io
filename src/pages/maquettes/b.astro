---
// Maquette B — « Banc d'essai »
// Parti pris : la page est un instrument. Un objet 3D manipulable en ouverture (volume neutre
// dessiné au canvas, en attendant les vrais modèles), puis des chapitres où le défilement
// pilote une cinématique. Le texte reste lisible sans JavaScript.
import Maquette from '../../layouts/Maquette.astro';
import { navigation, machines, secteurs, chiffres, outils, dateReglement } from '../../data/maquette';
---

<Maquette titre="Maquette B — Banc d’essai">
	<a class="evitement" href="#contenu">Aller au contenu</a>

	<header class="entete">
		<a href="/" class="marque" aria-label="Automachine, accueil">
			<img src="/images/logo/sans-texte.svg" alt="" width="59" height="59" />
			<span>Automachine</span>
		</a>
		<nav aria-label="Navigation principale">
			<ul>
				{navigation.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
			</ul>
		</nav>
	</header>

	<main id="contenu">
		<section class="ouverture">
			<div class="ouverture__texte">
				<p class="surtitre">Machines spéciales</p>
				<h1><span class="a-rediger">[À RÉDIGER]</span> une phrase courte, au présent.</h1>
				<p class="chapeau">
					<span class="a-rediger">[À RÉDIGER]</span> ce que le visiteur peut faire ici : tourner la
					machine, suivre son mouvement, tester ses connaissances.
				</p>
				<p class="actions">
					<a class="bouton" href="/machines">Explorer les machines</a>
				</p>
			</div>
			<figure class="scene" data-scene>
				<canvas width="900" height="700" aria-hidden="true"></canvas>
				<figcaption>
					<span class="consigne">Faites tourner le volume avec la souris ou le doigt.</span>
					<span class="a-rediger">[MODÈLE 3D À PRODUIRE] volume neutre en attendant la première machine.</span>
				</figcaption>
			</figure>
		</section>

		<section class="cinematique" id="cinematique" data-cinematique>
			<div class="cinematique__colle">
				<div class="cinematique__texte">
					<p class="surtitre">Ce que fait la machine</p>
					<h2>Le défilement pilote le mouvement</h2>
					<p>
						<span class="a-rediger">[À RÉDIGER]</span> trois étapes d’un cycle machine, une par
						paragraphe. L’axe avance quand vous descendez, revient quand vous remontez.
					</p>
					<ol class="etapes">
						<li data-etape="0"><strong>Étape 1</strong> <span class="a-rediger">[À RÉDIGER]</span></li>
						<li data-etape="1"><strong>Étape 2</strong> <span class="a-rediger">[À RÉDIGER]</span></li>
						<li data-etape="2"><strong>Étape 3</strong> <span class="a-rediger">[À RÉDIGER]</span></li>
					</ol>
				</div>
				<div class="banc" aria-hidden="true">
					<svg viewBox="0 0 600 320" class="banc__svg">
						<rect x="20" y="230" width="560" height="14" rx="2" class="bati" />
						<rect x="60" y="60" width="16" height="170" class="bati" />
						<rect x="524" y="60" width="16" height="170" class="bati" />
						<rect x="60" y="60" width="480" height="16" class="rail" />
						<g class="chariot" style="--x: 0">
							<rect x="0" y="40" width="70" height="56" rx="3" class="chariot__corps" />
							<rect x="28" y="96" width="14" height="70" class="chariot__tige" />
							<path d="M14 166 h42 l-6 30 h-30 z" class="chariot__pince" />
						</g>
						<rect x="200" y="196" width="200" height="34" rx="2" class="piece" />
					</svg>
					<div class="jauge"><span class="jauge__curseur"></span></div>
				</div>
			</div>
		</section>

		<section class="bloc" id="machines">
			<h2>Machines</h2>
			<p class="chapeau">
				<span class="a-rediger">[À RÉDIGER]</span> chaque fiche embarque le modèle 3D de la machine.
			</p>
			<ul class="machines">
				{
					machines.map((m) => (
						<li>
							<a href={`/machines/${m.slug}`}>
								<div class="visuel visuel--sombre">
									<span>[RENDU 3D] {m.nom}</span>
								</div>
								<h3>{m.nom}</h3>
								<p class="meta">{m.secteur}</p>
							</a>
						</li>
					))
				}
			</ul>
		</section>

		<section class="bloc bloc--clair" id="secteurs">
			<div class="deux-colonnes">
				<div>
					<h2>Secteurs</h2>
					<p><span class="a-rediger">[À RÉDIGER]</span> une entrée par domaine d’activité.</p>
				</div>
				<ul class="secteurs">
					{secteurs.map((s) => <li><a href={`/secteurs#${s.slug}`}>{s.nom}</a></li>)}
				</ul>
			</div>
		</section>

		<section class="bloc" id="outils">
			<h2>Outils à manipuler</h2>
			<div class="outils">
				{
					outils.map((o) => (
						<article>
							<h3>
								<a href={`/outils/${o.slug}`}>{o.nom}</a>
							</h3>
							<p>{o.accroche}</p>
							{o.slug === 'quiz-reglement-machines' && (
								<p class="compte" data-echeance={dateReglement}>
									<span class="compte__valeur" data-jours>—</span>
									<span class="compte__legende">jours avant le 20 janvier 2027, date d’application</span>
								</p>
							)}
							<p class={o.note.startsWith('[') ? 'a-rediger' : 'note'}>{o.note}</p>
						</article>
					))
				}
			</div>
		</section>

		<section class="bloc bloc--sombre" id="entreprise">
			<div class="deux-colonnes">
				<div>
					<h2>Entreprise</h2>
					<p>
						<span class="a-rediger">[À RÉDIGER]</span> 2011, création de Sourcitem. 2017, l’entreprise
						devient Automachine. Équipe, valeurs, certifications
						<span class="a-rediger">[À CONFIRMER : ISO 9001, ISO 14001]</span>.
					</p>
					<p><a class="lien-clair" href="/entreprise">Découvrir l’entreprise</a></p>
				</div>
				<dl class="chiffres">
					{
						chiffres.map((c) => (
							<div>
								<dt class={c.valeur.startsWith('[') ? 'a-rediger' : ''}>{c.valeur}</dt>
								<dd>{c.legende}</dd>
							</div>
						))
					}
				</dl>
			</div>
		</section>

		<section class="bloc appel">
			<h2>Décrivez-nous votre besoin</h2>
			<p><span class="a-rediger">[À RÉDIGER]</span></p>
			<p><a class="bouton" href="/contact">Contact</a></p>
		</section>
	</main>

	<footer class="pied">
		<p>Automachine — <span class="a-rediger">[À RÉDIGER] adresse, téléphone</span></p>
		<ul>
			<li><a href="/mentions-legales">Mentions légales</a></li>
			<li><a href="/confidentialite">Confidentialité</a></li>
		</ul>
	</footer>

	<script>
		// 1. Volume filaire manipulable (aucune bibliothèque). Un portique simplifié : bâti,
		//    deux montants, une traverse. Rotation à la souris ou au doigt, rotation lente au repos.
		const scene = document.querySelector<HTMLElement>('[data-scene]');
		const canvas = scene?.querySelector('canvas');
		const ctx = canvas?.getContext('2d');
		if (canvas && ctx) {
			const reduit = matchMedia('(prefers-reduced-motion: reduce)').matches;
			type P = [number, number, number];
			const boite = (x: number, y: number, z: number, w: number, h: number, d: number): P[] => [
				[x, y, z], [x + w, y, z], [x + w, y + h, z], [x, y + h, z],
				[x, y, z + d], [x + w, y, z + d], [x + w, y + h, z + d], [x, y + h, z + d],
			];
			const aretes = [[0, 1], [1, 2], [2, 3], [3, 0], [4, 5], [5, 6], [6, 7], [7, 4], [0, 4], [1, 5], [2, 6], [3, 7]];
			// Bâti, deux montants, traverse, chariot.
			const volumes = [
				boite(-1.6, 0.9, -0.9, 3.2, 0.25, 1.8),
				boite(-1.4, -0.9, -0.2, 0.2, 1.8, 0.4),
				boite(1.2, -0.9, -0.2, 0.2, 1.8, 0.4),
				boite(-1.4, -0.9, -0.15, 2.8, 0.2, 0.3),
				boite(-0.4, -0.7, -0.25, 0.5, 0.6, 0.5),
			];
			let ax = -0.35, ay = 0.7, vx = 0, vy = 0, drag = false, lx = 0, ly = 0;
			const couleurs = ['#53769a', '#2e4560', '#2e4560', '#53769a', '#f79f22'];
			const rendu = () => {
				const W = canvas.width, H = canvas.height, s = Math.min(W, H) * 0.22;
				ctx.clearRect(0, 0, W, H);
				const cx = Math.cos(ax), sx = Math.sin(ax), cy = Math.cos(ay), sy = Math.sin(ay);
				const proj = ([x, y, z]: P) => {
					const x1 = x * cy + z * sy, z1 = -x * sy + z * cy;
					const y1 = y * cx - z1 * sx, z2 = y * sx + z1 * cx;
					const k = 3.2 / (3.2 + z2 * 0.35);
					return [W / 2 + x1 * s * k, H / 2 + y1 * s * k];
				};
				ctx.lineWidth = 2;
				ctx.lineJoin = 'round';
				volumes.forEach((v, i) => {
					const pts = v.map(proj);
					ctx.strokeStyle = couleurs[i];
					ctx.beginPath();
					for (const [a, b] of aretes) {
						ctx.moveTo(pts[a][0], pts[a][1]);
						ctx.lineTo(pts[b][0], pts[b][1]);
					}
					ctx.stroke();
				});
			};
			const boucle = () => {
				if (!drag) {
					ay += vy + (reduit ? 0 : 0.003);
					ax += vx;
					vx *= 0.92;
					vy *= 0.92;
					ax = Math.max(-1.2, Math.min(1.2, ax));
				}
				rendu();
				requestAnimationFrame(boucle);
			};
			const debut = (x: number, y: number) => { drag = true; lx = x; ly = y; scene!.classList.add('actif'); };
			const mouvement = (x: number, y: number) => {
				if (!drag) return;
				vy = (x - lx) * 0.008;
				vx = (y - ly) * 0.008;
				ay += vy;
				ax = Math.max(-1.2, Math.min(1.2, ax + vx));
				lx = x; ly = y;
			};
			const fin = () => { drag = false; scene!.classList.remove('actif'); };
			canvas.addEventListener('pointerdown', (e) => { canvas.setPointerCapture(e.pointerId); debut(e.clientX, e.clientY); });
			canvas.addEventListener('pointermove', (e) => mouvement(e.clientX, e.clientY));
			canvas.addEventListener('pointerup', fin);
			canvas.addEventListener('pointercancel', fin);
			boucle();
		}

		// 2. Cinématique pilotée par le défilement : le chariot parcourt sa course pendant que
		//    la section reste collée à l'écran. Les étapes s'allument au passage.
		const section = document.querySelector<HTMLElement>('[data-cinematique]');
		if (section) {
			const chariot = section.querySelector<SVGGElement>('.chariot');
			const curseur = section.querySelector<HTMLElement>('.jauge__curseur');
			const etapes = section.querySelectorAll<HTMLElement>('[data-etape]');
			const maj = () => {
				const r = section.getBoundingClientRect();
				const course = r.height - innerHeight;
				const p = course > 0 ? Math.min(1, Math.max(0, -r.top / course)) : 0;
				chariot?.style.setProperty('--x', String(p * 410));
				if (curseur) curseur.style.width = `${p * 100}%`;
				etapes.forEach((e, i) => e.classList.toggle('active', p >= i / 3 && (i === 2 || p < (i + 1) / 3)));
			};
			addEventListener('scroll', maj, { passive: true });
			addEventListener('resize', maj);
			maj();
		}

		// 3. Compte à rebours.
		for (const el of document.querySelectorAll<HTMLElement>('[data-echeance]')) {
			const jours = Math.ceil((new Date(el.dataset.echeance + 'T00:00:00').getTime() - Date.now()) / 86_400_000);
			const s = el.querySelector('[data-jours]');
			if (s && jours > 0) s.textContent = String(jours);
		}
	</script>
</Maquette>

<style>
	.evitement { position: absolute; left: -999px; top: 0; background: var(--bleu-nuit); color: var(--blanc); padding: 0.5rem 1rem; }
	.evitement:focus { left: 1rem; z-index: 10; }

	.entete {
		position: sticky;
		top: 0;
		z-index: 5;
		background: rgba(255, 255, 255, 0.92);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--gris-moyen);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		padding: 0.75rem clamp(1rem, 4vw, 3rem);
	}
	.marque {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		text-decoration: none;
		color: var(--bleu-nuit);
		font-family: var(--titres);
		font-weight: 700;
		font-size: 1.2rem;
		letter-spacing: 0.02em;
	}
	.marque img { width: 36px; height: 36px; }
	.entete nav ul { list-style: none; margin: 0; padding: 0; display: flex; gap: clamp(0.75rem, 2vw, 1.75rem); flex-wrap: wrap; }
	.entete nav a { text-decoration: none; color: var(--gris); font-weight: 500; font-size: 0.95rem; }
	.entete nav a:hover { color: var(--bleu); }

	.ouverture {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
		gap: 2rem;
		align-items: center;
		padding: clamp(2rem, 6vw, 5rem) clamp(1rem, 4vw, 3rem);
		max-width: 80rem;
		margin: 0 auto;
	}
	@media (max-width: 800px) {
		.ouverture { grid-template-columns: 1fr; }
	}
	.surtitre { font-family: var(--titres); font-weight: 500; color: var(--bleu); text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.85rem; margin-bottom: 1rem; }
	.ouverture h1 { font-size: clamp(2rem, 4.5vw, 3.25rem); }
	.chapeau { font-size: 1.15rem; }
	.actions { margin-top: 1.5rem; }
	.bouton { display: inline-block; background: var(--bleu-nuit); color: var(--blanc); text-decoration: none; font-weight: 500; padding: 0.8rem 1.4rem; border-radius: var(--rayon); }
	.bouton:hover { background: var(--bleu); color: var(--blanc); }

	.scene { margin: 0; }
	.scene canvas {
		width: 100%;
		aspect-ratio: 9 / 7;
		cursor: grab;
		touch-action: none;
		background: var(--gris-clair);
		border: 1px solid var(--gris-moyen);
		border-radius: var(--rayon);
	}
	.scene.actif canvas { cursor: grabbing; }
	.scene figcaption { font-size: 0.85rem; color: var(--gris-leger); display: flex; flex-direction: column; gap: 0.2rem; margin-top: 0.5rem; }
	.consigne { color: var(--bleu); font-weight: 500; }

	/* Cinématique collée : la section fait 3 écrans de haut, son contenu reste fixe. */
	.cinematique { background: var(--bleu-nuit); color: var(--blanc); }
	.cinematique__colle {
		position: sticky;
		top: 0;
		min-height: 100vh;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
		gap: 2rem;
		align-items: center;
		padding: clamp(2rem, 6vw, 4rem) clamp(1rem, 4vw, 3rem);
		max-width: 80rem;
		margin: 0 auto;
	}
	@media (max-width: 800px) {
		.cinematique__colle { grid-template-columns: 1fr; align-content: start; }
	}
	@supports (position: sticky) {
		.cinematique { min-height: 300vh; }
	}
	.cinematique h2, .cinematique .surtitre { color: var(--blanc); }
	.cinematique .surtitre { color: var(--bleu-clair); }
	.cinematique .a-rediger { color: var(--bleu-clair); }
	.etapes { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; gap: 0.5rem; }
	.etapes li { padding: 0.6rem 0.9rem; border-left: 3px solid rgba(255, 255, 255, 0.2); transition: border-color 0.2s, background 0.2s; }
	.etapes li.active { border-color: var(--orange); background: rgba(255, 255, 255, 0.06); }
	.banc__svg { width: 100%; }
	.bati { fill: #3b587a; }
	.rail { fill: var(--bleu-clair); }
	.chariot { transform: translateX(calc(var(--x, 0) * 1px)); }
	.chariot__corps { fill: var(--orange); }
	.chariot__tige { fill: var(--bleu-clair); }
	.chariot__pince { fill: var(--bleu-clair); }
	.piece { fill: none; stroke: var(--bleu-clair); stroke-dasharray: 6 4; }
	.jauge { height: 4px; background: rgba(255, 255, 255, 0.15); margin-top: 0.5rem; }
	.jauge__curseur { display: block; height: 100%; width: 0; background: var(--orange); }

	.bloc { padding: clamp(3rem, 7vw, 5rem) clamp(1rem, 4vw, 3rem); max-width: 80rem; margin: 0 auto; }
	.bloc h2 { font-size: clamp(1.75rem, 4vw, 2.5rem); }
	.bloc--clair { max-width: none; background: var(--gris-clair); }
	.bloc--clair > *, .bloc--sombre > * { max-width: 80rem; margin-left: auto; margin-right: auto; }
	.bloc--sombre { max-width: none; background: var(--bleu-sombre); color: var(--blanc); }
	.bloc--sombre h2 { color: var(--blanc); }
	.bloc--sombre .a-rediger { color: var(--bleu-clair); }
	.lien-clair { color: var(--blanc); }
	.lien-clair:hover { color: var(--orange); }

	.machines { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); gap: 1.5rem; }
	.machines a { text-decoration: none; color: inherit; display: block; }
	.machines .visuel { aspect-ratio: 4 / 3; transition: transform 0.2s; }
	.machines a:hover .visuel { transform: translateY(-3px); }
	.machines h3 { font-size: 1.25rem; margin: 0.75rem 0 0.15rem; }
	.meta { color: var(--bleu); font-size: 0.9rem; font-weight: 500; }

	.deux-colonnes { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 3rem; align-items: start; }
	@media (max-width: 800px) { .deux-colonnes { grid-template-columns: 1fr; } }
	.secteurs { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: 0.75rem; }
	.secteurs a { display: block; background: var(--blanc); border: 1px solid var(--gris-moyen); border-radius: var(--rayon); padding: 1rem; text-decoration: none; color: var(--bleu-nuit); font-family: var(--titres); font-size: 1.15rem; font-weight: 600; }
	.secteurs a:hover { border-color: var(--bleu); color: var(--bleu); }

	.outils { display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: 1.5rem; margin-top: 2rem; }
	.outils article { border: 1px solid var(--gris-moyen); border-radius: var(--rayon); padding: 1.5rem; }
	.outils h3 { font-size: 1.35rem; }
	.outils h3 a { text-decoration: none; }
	.compte { display: flex; align-items: baseline; gap: 0.6rem; flex-wrap: wrap; }
	.compte__valeur { font-family: var(--titres); font-weight: 700; font-size: 2.5rem; color: var(--bleu); line-height: 1; }
	.compte__legende { font-size: 0.9rem; color: var(--gris-leger); }
	.note { font-size: 0.85rem; color: var(--gris-leger); }

	.chiffres { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; margin: 0; }
	.chiffres dt { font-family: var(--titres); font-size: 2.25rem; font-weight: 600; color: var(--blanc); line-height: 1; }
	.chiffres dt.a-rediger { font-size: 1rem; font-weight: 400; font-family: var(--texte); }
	.chiffres dd { margin: 0.35rem 0 0; font-size: 0.9rem; color: var(--bleu-clair); }

	.appel { text-align: center; }
	.appel p { margin-left: auto; margin-right: auto; }

	.pied { border-top: 1px solid var(--gris-moyen); padding: 2rem clamp(1rem, 4vw, 3rem); display: flex; flex-wrap: wrap; gap: 1rem 3rem; font-size: 0.9rem; color: var(--gris-leger); }
	.pied p { margin: 0; }
	.pied ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 1.5rem; }
</style>
