---
// Gabarit des maquettes du lot 1 : en-tête HTML commun, non indexé.
import '../styles/base.css';

interface Props {
	titre: string;
	description?: string;
}
const { titre, description = 'Maquette de page d’accueil, lot 1.' } = Astro.props;
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{titre} — Automachine (maquette)</title>
		<link rel="icon" type="image/svg+xml" href="/images/logo/sans-texte.svg" />
		<link
			rel="preload"
			href="/fonts/league-spartan-600-latin.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/ibm-plex-sans-400-latin.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
	</head>
	<body>
		<slot />
	</body>
</html>
