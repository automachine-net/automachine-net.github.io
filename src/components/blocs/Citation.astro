---
// Bloc « citation ». Une phrase mise en avant, son auteur, sa fonction.
import { classeFond as classeFond_ } from '../../scripts/blocs';

export interface BlocCitation {
	type: 'citation';
	citation: string;
	auteur?: string;
	fonction?: string;
	fond?: 'blanc' | 'clair' | 'sombre';
}

const { bloc } = Astro.props as { bloc: BlocCitation };
const classeFond = classeFond_(bloc.fond);
---

<section class={`bloc ${classeFond}`}>
	<div class="bloc__interieur">
		<figure class="citation">
			<blockquote>
				<p>{bloc.citation}</p>
			</blockquote>
			{
				(bloc.auteur || bloc.fonction) && (
					<figcaption>
						{bloc.auteur && <strong>{bloc.auteur}</strong>}
						{bloc.auteur && bloc.fonction && ' — '}
						{bloc.fonction}
					</figcaption>
				)
			}
		</figure>
	</div>
</section>

<style>
	.citation {
		margin: 0;
		max-width: 46rem;
	}
	.citation blockquote {
		margin: 0;
		border-left: 3px solid var(--bleu-clair);
		padding-left: clamp(1rem, 3vw, 2rem);
	}
	.citation p {
		font-family: var(--titres);
		font-size: clamp(1.3rem, 3vw, 1.9rem);
		font-weight: 500;
		line-height: 1.3;
		color: var(--bleu-nuit);
		margin: 0;
		max-width: none;
	}
	.bloc--sombre .citation p {
		color: var(--blanc);
	}
	.citation figcaption {
		margin-top: 1rem;
		padding-left: clamp(1rem, 3vw, 2rem);
		font-size: 0.9rem;
		color: var(--gris-leger);
	}
	.bloc--sombre .citation figcaption {
		color: var(--bleu-clair);
	}
</style>
