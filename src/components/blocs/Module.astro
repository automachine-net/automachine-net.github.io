---
// Bloc « module ». Insère un outil interactif dans une page.
// Chaque outil est un composant autonome ; ce bloc choisit lequel afficher.
import QuizExtrait from '../modules/QuizExtrait.astro';
import CompteARebours from '../modules/CompteARebours.astro';
import SimulateurCarbone from '../modules/SimulateurCarbone.astro';
import ApercuCarbone from '../modules/ApercuCarbone.astro';
import EstimateurPrix from '../modules/EstimateurPrix.astro';
import QuizComplet from '../modules/QuizComplet.astro';
import FluxMatieres from '../modules/FluxMatieres.astro';
import BoucleHelice from '../modules/BoucleHelice.astro';
import { classeFond as classeFond_ } from '../../scripts/blocs';

export interface BlocModule {
	type: 'module';
	titre?: string;
	introduction?: string;
	/** Outil à insérer. */
	module:
		| 'quiz-extrait'
		| 'quiz-complet'
		| 'compte-a-rebours'
		| 'apercu-carbone'
		| 'simulateur-carbone'
		| 'estimateur-prix'
		| 'flux-matieres'
		| 'reversibilite'
		| 'a-venir';
	/** Nombre de questions montrées par l'extrait de quiz. */
	nombre_questions?: number;
	lien_libelle?: string;
	lien_url?: string;
	/** Texte du cadre d'attente pour un module pas encore construit. */
	attente?: string;
	fond?: 'blanc' | 'clair' | 'sombre';
}

const { bloc } = Astro.props as { bloc: BlocModule };
const classeFond = classeFond_(bloc.fond);
---

<section class={`bloc ${classeFond}`}>
	<div class="bloc__interieur">
		{bloc.titre && <h2>{bloc.titre}</h2>}
		{bloc.introduction && <p class="introduction" set:html={bloc.introduction} />}

		{bloc.module === 'compte-a-rebours' && <CompteARebours carte={bloc.fond !== 'sombre'} />}
		{bloc.module === 'apercu-carbone' && <ApercuCarbone />}
		{bloc.module === 'simulateur-carbone' && <SimulateurCarbone compact />}
		{bloc.module === 'estimateur-prix' && <EstimateurPrix />}
		{bloc.module === 'quiz-complet' && <QuizComplet />}
		{bloc.module === 'flux-matieres' && <FluxMatieres />}
		{bloc.module === 'reversibilite' && <BoucleHelice />}
		{
			bloc.module === 'quiz-extrait' && (
				<QuizExtrait
					nombre={bloc.nombre_questions ?? 3}
					lien_libelle={bloc.lien_libelle}
					lien_url={bloc.lien_url}
				/>
			)
		}
		{
			bloc.module === 'a-venir' && (
				<div class={`visuel visuel--module ${bloc.fond === 'sombre' ? 'visuel--sombre' : ''}`}>
					<span>{bloc.attente ?? '[MODULE À CONSTRUIRE]'}</span>
				</div>
			)
		}

		{/* Pour le quiz, le lien est affiché à l'intérieur du module, sous les questions. */}
		{
			bloc.lien_url && bloc.module !== 'quiz-extrait' && (
				<p class="apres">
					<a class={`bouton ${bloc.fond === 'sombre' ? 'bouton--clair' : ''}`} href={bloc.lien_url}>
						{bloc.lien_libelle ?? 'Ouvrir l’outil'}
					</a>
				</p>
			)
		}
	</div>
</section>

<style>
	.introduction {
		max-width: var(--mesure);
		font-size: 1.05rem;
	}
	.visuel--module {
		height: clamp(9rem, 18vw, 13rem);
		margin-top: 1.75rem;
	}
	.apres {
		margin: 1.75rem 0 0;
	}
</style>
