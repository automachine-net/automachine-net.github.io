---
// Bloc « clients ». Les logos, à taille égale, sur une grille régulière.
import reglagesClients from '../../../content/reglages/clients.json';
import { classeFond as classeFond_ } from '../../scripts/blocs';

export interface BlocClients {
	type: 'clients';
	titre?: string;
	fond?: 'blanc' | 'clair' | 'sombre';
}

const { bloc } = Astro.props as { bloc: BlocClients };
const classeFond = classeFond_(bloc.fond);
const titre = bloc.titre ?? reglagesClients.titre;
---

<section class={`bloc ${classeFond}`}>
	<div class="bloc__interieur">
		<h2 class="clients__titre">{titre}</h2>
		<ul class="clients">
			{
				reglagesClients.clients.map((c) => (
					<li>
						<img src={c.logo} alt={c.nom} width="200" height="200" loading="lazy" decoding="async" />
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.clients__titre {
		text-align: center;
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.09em;
		color: var(--gris-leger);
		font-weight: 600;
		margin-bottom: 2.5rem;
	}
	.bloc--sombre .clients__titre {
		color: var(--bleu-clair);
	}

	/* Colonnes de largeur égale, qui se répartissent d'elles-mêmes quel que soit le nombre de
	   logos. Pas de cadres : c'est l'alignement qui structure la rangée. */
	.clients {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(6rem, 1fr));
		align-items: center;
		gap: 2.5rem 1.5rem;
	}
	.clients li {
		display: grid;
		place-items: center;
	}
	/* La hauteur du logo est donnée en valeur absolue, jamais en pourcentage : dans une case
	   centrée, une hauteur en pourcentage ne se résout pas et le navigateur retombe sur la
	   taille d'origine de l'image, qui déborde. « contain » conserve les proportions.
	   Cette hauteur fixe réserve aussi la place avant le chargement : rien ne saute. */
	.clients img {
		width: 100%;
		height: 3rem;
		object-fit: contain;
	}
</style>
