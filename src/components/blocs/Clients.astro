---
// Bloc « clients ». Les logos, à taille égale, sur une grille régulière.
import reglagesClients from '../../../content/reglages/clients.json';

export interface BlocClients {
	type: 'clients';
	titre?: string;
	fond?: 'blanc' | 'clair' | 'sombre';
}

const { bloc } = Astro.props as { bloc: BlocClients };
const classeFond = bloc.fond === 'clair' ? 'bloc--clair' : bloc.fond === 'sombre' ? 'bloc--sombre' : '';
const titre = bloc.titre ?? reglagesClients.titre;
---

<section class={`bloc ${classeFond}`}>
	<div class="bloc__interieur">
		<h2>{titre}</h2>
		<ul class="clients">
			{
				reglagesClients.clients.map((c) => (
					<li>
						<img src={c.logo} alt={c.nom} width="200" height="200" loading="lazy" decoding="async" />
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.clients {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
		gap: 1px;
		background: var(--gris-moyen);
		border: 1px solid var(--gris-moyen);
	}
	.clients li {
		background: var(--blanc);
		display: grid;
		place-items: center;
		min-height: 7rem;
		padding: 1rem;
	}
	/* Hauteur fixée : la place est réservée avant le chargement, la mise en page ne saute pas. */
	.clients img {
		width: 100%;
		height: 4.5rem;
		object-fit: contain;
	}
</style>
