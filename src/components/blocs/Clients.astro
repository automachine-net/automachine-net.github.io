---
// Bloc « clients ». Les logos, à taille égale, sur une grille régulière.
import reglagesClients from '../../../content/reglages/clients.json';
import { classeFond as classeFond_ } from '../../scripts/blocs';

export interface BlocClients {
	type: 'clients';
	titre?: string;
	fond?: 'blanc' | 'clair' | 'sombre';
}

const { bloc } = Astro.props as { bloc: BlocClients };
const classeFond = classeFond_(bloc.fond);
const titre = bloc.titre ?? reglagesClients.titre;
---

<section class={`bloc ${classeFond}`}>
	<div class="bloc__interieur">
		<h2 class="clients__titre">{titre}</h2>
		<ul class="clients">
			{
				reglagesClients.clients.map((c) => (
					<li>
						<img src={c.logo} alt={c.nom} width="200" height="200" loading="lazy" decoding="async" />
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.clients__titre {
		text-align: center;
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.09em;
		color: var(--gris-leger);
		font-weight: 600;
		margin-bottom: 2.5rem;
	}
	.bloc--sombre .clients__titre {
		color: var(--bleu-clair);
	}

	/* Pas de grille ni de cadres : une simple rangée de logos, régulièrement espacés,
	   qui passe à la ligne quand il le faut. */
	.clients {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: clamp(1.5rem, 3.5vw, 3rem);
	}
	/* Chaque logo occupe la même case : leurs formes très différentes ne déséquilibrent pas
	   la rangée. La case réserve aussi la place avant le chargement de l'image. */
	.clients li {
		flex: 0 0 auto;
		width: 6.5rem;
		height: 3rem;
		display: grid;
		place-items: center;
	}
	.clients img {
		max-width: 100%;
		max-height: 100%;
		width: auto;
		height: auto;
		object-fit: contain;
		opacity: 0.85;
		transition: opacity 0.2s;
	}
	.clients img:hover {
		opacity: 1;
	}
</style>
