---
// Bandeau supérieur, collé en haut. Le menu se replie derrière un bouton sur petit écran.
import navigation from '../../content/reglages/navigation.json';
import site from '../../content/reglages/site.json';

const chemin = Astro.url.pathname.replace(/\/$/, '') || '/';
const estActif = (href: string) => chemin === href || (href !== '/' && chemin.startsWith(href));
---

<header class="entete">
	<a href="/" class="marque" aria-label={`${site.nom}, accueil`}>
		<img
			src="/images/logo/avec-texte.svg"
			alt={`${site.nom}, ${site.baseline.toLowerCase()}`}
			width="157"
			height="59"
		/>
	</a>

	<button class="bascule" type="button" aria-expanded="false" aria-controls="menu-principal">
		<span class="bascule__icone" aria-hidden="true">
			<span></span>
			<span></span>
			<span></span>
		</span>
		<span class="sr-only">Ouvrir le menu</span>
	</button>

	<nav id="menu-principal" aria-label="Navigation principale">
		<ul>
			{
				navigation.principale.map((n) => (
					<li>
						<a href={n.href} aria-current={estActif(n.href) ? 'page' : undefined}>
							{n.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>

<script>
	// Menu repliable. Sans JavaScript, le menu reste affiché : rien n'est caché par défaut en CSS
	// tant que le bouton n'a pas pris la main.
	const bouton = document.querySelector<HTMLButtonElement>('.bascule');
	const entete = document.querySelector<HTMLElement>('.entete');
	if (bouton && entete) {
		entete.classList.add('entete--repliable');
		const libelle = bouton.querySelector('.sr-only')!;
		const basculer = (ouvert: boolean) => {
			bouton.setAttribute('aria-expanded', String(ouvert));
			entete.classList.toggle('entete--ouvert', ouvert);
			libelle.textContent = ouvert ? 'Fermer le menu' : 'Ouvrir le menu';
		};
		bouton.addEventListener('click', () => basculer(bouton.getAttribute('aria-expanded') !== 'true'));
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') basculer(false);
		});
	}
</script>

<style>
	.entete {
		position: sticky;
		top: 0;
		z-index: 20;
		background: var(--blanc);
		border-bottom: 2px solid var(--bleu-nuit);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 0.9rem var(--marge);
	}
	.marque {
		display: block;
		flex: 0 0 auto;
		line-height: 0;
	}
	.marque img {
		width: 168px;
		height: auto;
	}
	@media (max-width: 480px) {
		.marque img {
			width: 140px;
		}
	}

	nav ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		gap: clamp(1rem, 2.2vw, 2rem);
		flex-wrap: wrap;
	}
	nav a {
		display: block;
		text-decoration: none;
		color: var(--bleu-nuit);
		font-family: var(--titres);
		font-weight: 600;
		font-size: 0.95rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		padding: 0.3rem 0;
		border-bottom: 2px solid transparent;
	}
	nav a:hover {
		color: var(--bleu);
	}
	nav a[aria-current='page'] {
		border-bottom-color: var(--orange);
	}

	/* Bouton du menu : sans cadre, zone de clic de 44 px, les trois barres deviennent une croix. */
	.bascule {
		display: none;
		width: 44px;
		height: 44px;
		padding: 0;
		margin-right: -0.6rem;
		background: none;
		border: 0;
		color: var(--bleu-nuit);
		cursor: pointer;
		place-items: center;
		-webkit-tap-highlight-color: transparent;
	}
	.bascule__icone {
		position: relative;
		display: block;
		width: 24px;
		height: 16px;
	}
	.bascule__icone span {
		position: absolute;
		left: 0;
		width: 100%;
		height: 2px;
		background: currentColor;
		transition:
			top 0.18s,
			transform 0.18s,
			opacity 0.18s;
	}
	.bascule__icone span:nth-child(1) {
		top: 0;
	}
	.bascule__icone span:nth-child(2) {
		top: 7px;
	}
	.bascule__icone span:nth-child(3) {
		top: 14px;
	}
	.entete--ouvert .bascule__icone span:nth-child(1) {
		top: 7px;
		transform: rotate(45deg);
	}
	.entete--ouvert .bascule__icone span:nth-child(2) {
		opacity: 0;
	}
	.entete--ouvert .bascule__icone span:nth-child(3) {
		top: 7px;
		transform: rotate(-45deg);
	}

	@media (max-width: 760px) {
		.entete--repliable .bascule {
			display: grid;
		}
		.entete--repliable nav {
			display: none;
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			background: var(--blanc);
			border-bottom: 2px solid var(--bleu-nuit);
			padding: 0 var(--marge) 0.5rem;
		}
		.entete--ouvert nav {
			display: block;
		}
		.entete--repliable nav ul {
			flex-direction: column;
			gap: 0;
		}
		.entete--repliable nav a {
			padding: 0.9rem 0;
			border-bottom: 1px solid var(--gris-moyen);
			border-left: 2px solid transparent;
			padding-left: 0;
		}
		/* La dernière entrée n'a pas de filet : le trait fort du bandeau ferme déjà le menu. */
		.entete--repliable nav li:last-child a {
			border-bottom: 0;
		}
		.entete--repliable nav a[aria-current='page'] {
			color: var(--bleu);
		}
	}
</style>
