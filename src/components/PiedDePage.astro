---
import navigation from '../../content/reglages/navigation.json';
import site from '../../content/reglages/site.json';

const annee = new Date().getFullYear();
const aCompleter = (v: string) => v.startsWith('[');
---

<footer class="pied">
	<div class="pied__interieur">
		<div class="pied__marque">
			<img src="/images/logo/fond-noir.svg" alt="" width="157" height="59" />
			<p class="pied__baseline">{site.baseline}</p>
		</div>

		<address class="pied__coordonnees">
			{site.adresse_voie}<br />
			{site.adresse_code_postal} {site.adresse_ville}<br />
			{site.adresse_pays}
			<br /><br />
			{
				aCompleter(site.telephone) ? (
					<span class="a-rediger">{site.telephone}</span>
				) : (
					<a href={`tel:${site.telephone.replace(/\s/g, '')}`}>{site.telephone}</a>
				)
			}
		</address>

		<nav class="pied__liens" aria-label="Navigation du pied de page">
			<ul>
				{navigation.principale.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
				{navigation.pied.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
			</ul>
		</nav>
	</div>
	<p class="pied__bas">© {annee} {site.nom}</p>
</footer>

<style>
	.pied {
		background: var(--bleu-nuit);
		color: var(--blanc);
		padding: clamp(2.5rem, 6vw, 4rem) var(--marge) 1.5rem;
		margin-top: clamp(3rem, 8vw, 5rem);
	}
	.pied__interieur {
		max-width: var(--largeur);
		margin: 0 auto;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
		gap: 2rem 3rem;
		align-items: start;
	}
	.pied__marque img {
		width: 140px;
		height: auto;
	}
	.pied__baseline {
		margin: 0.5rem 0 0;
		color: var(--bleu-clair);
		font-size: 0.9rem;
	}
	.pied__coordonnees {
		font-style: normal;
		font-size: 0.95rem;
		line-height: 1.7;
	}
	.pied__coordonnees a {
		color: var(--blanc);
	}
	.pied a {
		color: var(--blanc);
	}
	.pied a:hover {
		color: var(--orange);
	}
	.pied .a-rediger {
		color: var(--bleu-clair);
	}
	.pied__liens ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.4rem;
		font-size: 0.95rem;
	}
	.pied__bas {
		max-width: var(--largeur);
		margin: 2.5rem auto 0;
		padding-top: 1.25rem;
		border-top: 1px solid rgba(255, 255, 255, 0.2);
		font-size: 0.85rem;
		color: var(--bleu-clair);
	}
</style>
