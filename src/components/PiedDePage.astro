---
import navigation from '../../content/reglages/navigation.json';
import site from '../../content/reglages/site.json';

const annee = new Date().getFullYear();
const aCompleter = (v: string) => v.trim().startsWith('[');
---

<footer class="pied">
	<div class="pied__interieur">
		{/* Le logo occupe sa propre ligne : il ne se retrouve jamais à côté d'une colonne
		    plus haute que lui, ce qui creusait un grand vide en dessous. */}
		<a class="pied__marque" href="/" aria-label={`${site.nom}, accueil`}>
			<img src="/images/logo/fond-noir.svg" alt="" width="157" height="59" />
		</a>

		<div class="pied__colonnes">
			<div>
				<h2>Nous trouver</h2>
				<address>
					{site.adresse_voie}<br />
					{site.adresse_code_postal} {site.adresse_ville}<br />
					{site.adresse_pays}
				</address>
				<p class="pied__telephone">
					{
						aCompleter(site.telephone) ? (
							<span class="a-rediger">{site.telephone}</span>
						) : (
							<a href={`tel:${site.telephone.replace(/\s/g, '')}`}>{site.telephone}</a>
						)
					}
				</p>
			</div>

			<nav aria-label="Navigation du pied de page">
				<h2>Le site</h2>
				<ul>
					{navigation.principale.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
				</ul>
			</nav>

			<div>
				<h2>Informations</h2>
				<ul>
					{navigation.pied.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
				</ul>
			</div>
		</div>

		<p class="pied__bas">© {annee} {site.nom}</p>
	</div>
</footer>

<style>
	.pied {
		background: var(--bleu-nuit);
		color: var(--blanc);
		padding: clamp(2.5rem, 5vw, 3.5rem) var(--marge) 1.5rem;
		margin-top: clamp(3rem, 8vw, 5rem);
	}
	.pied__interieur {
		max-width: var(--largeur);
		margin: 0 auto;
	}

	.pied__marque {
		display: block;
		width: fit-content;
		line-height: 0;
		margin-bottom: 2.5rem;
	}
	.pied__marque img {
		width: 150px;
		height: auto;
	}

	.pied__colonnes {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
		gap: 2rem 2.5rem;
		align-items: start;
	}

	.pied__colonnes h2 {
		font-size: 0.78rem;
		text-transform: uppercase;
		letter-spacing: 0.09em;
		color: var(--bleu-clair);
		margin: 0 0 0.9rem;
		font-weight: 600;
	}

	address {
		font-style: normal;
		font-size: 0.95rem;
		line-height: 1.7;
		margin: 0;
	}
	.pied__telephone {
		margin: 0.6rem 0 0;
		font-size: 0.95rem;
	}

	.pied ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.5rem;
		font-size: 0.95rem;
	}
	.pied a {
		color: var(--blanc);
		text-decoration: none;
	}
	.pied a:hover {
		color: var(--orange);
		text-decoration: underline;
		text-decoration-color: var(--orange);
	}
	.pied .a-rediger {
		color: var(--bleu-clair);
	}

	.pied__bas {
		margin: 2.5rem 0 0;
		padding-top: 1.25rem;
		border-top: 1px solid rgba(255, 255, 255, 0.18);
		font-size: 0.85rem;
		color: var(--bleu-clair);
	}
</style>
