---
import navigation from '../../content/reglages/navigation.json';
import site from '../../content/reglages/site.json';

const annee = new Date().getFullYear();
const aCompleter = (v: string) => v.trim().startsWith('[');
---

<footer class="pied">
	<div class="pied__interieur">
		<div class="pied__colonne pied__colonne--marque">
			<img src="/images/logo/fond-noir.svg" alt={site.nom} width="157" height="59" />
		</div>

		<div class="pied__colonne">
			<h2>Nous trouver</h2>
			<address>
				{site.adresse_voie}<br />
				{site.adresse_code_postal} {site.adresse_ville}<br />
				{site.adresse_pays}
			</address>
			<p class="pied__telephone">
				{
					aCompleter(site.telephone) ? (
						<span class="a-rediger">{site.telephone}</span>
					) : (
						<a href={`tel:${site.telephone.replace(/\s/g, '')}`}>{site.telephone}</a>
					)
				}
			</p>
		</div>

		<nav class="pied__colonne" aria-label="Navigation du pied de page">
			<h2>Le site</h2>
			<ul>
				{navigation.principale.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
			</ul>
		</nav>

		<div class="pied__colonne">
			<h2>Informations</h2>
			<ul>
				{navigation.pied.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
			</ul>
		</div>
	</div>

	<p class="pied__bas">© {annee} {site.nom}</p>
</footer>

<style>
	.pied {
		background: var(--bleu-nuit);
		color: var(--blanc);
		padding: clamp(3rem, 6vw, 4.5rem) var(--marge) 1.75rem;
		margin-top: clamp(3rem, 8vw, 5rem);
	}
	.pied__interieur {
		max-width: var(--largeur);
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1.4fr 1fr 1fr 1fr;
		gap: 2.5rem;
		align-items: start;
	}
	@media (max-width: 860px) {
		.pied__interieur {
			grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
		}
	}

	.pied__colonne h2 {
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.09em;
		color: var(--bleu-clair);
		margin: 0 0 1rem;
		font-weight: 600;
	}
	.pied__colonne--marque img {
		width: 160px;
		height: auto;
	}

	address {
		font-style: normal;
		font-size: 0.95rem;
		line-height: 1.75;
		margin: 0;
	}
	.pied__telephone {
		margin: 0.75rem 0 0;
		font-size: 0.95rem;
	}

	.pied ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.6rem;
		font-size: 0.95rem;
	}
	.pied a {
		color: var(--blanc);
		text-decoration: none;
	}
	.pied a:hover {
		color: var(--orange);
		text-decoration: underline;
	}
	.pied .a-rediger {
		color: var(--bleu-clair);
	}

	.pied__bas {
		max-width: var(--largeur);
		margin: 3rem auto 0;
		padding-top: 1.5rem;
		border-top: 1px solid rgba(255, 255, 255, 0.18);
		font-size: 0.85rem;
		color: var(--bleu-clair);
	}
</style>
