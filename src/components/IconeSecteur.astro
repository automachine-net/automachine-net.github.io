---
// Pictogrammes de secteurs, dessinés au trait dans la palette Automachine.
// Choix assumé : les illustrations fournies dans les ressources sont des vectoriels
// d'aspect « banque d'images », hors palette, que la direction artistique exclut.
// Ces tracés reprennent le langage filaire des volumes 3D de la page.
interface Props {
	secteur: string;
	taille?: number;
}
const { secteur, taille = 48 } = Astro.props;
---

<svg
	width={taille}
	height={taille}
	viewBox="0 0 48 48"
	fill="none"
	stroke="currentColor"
	stroke-width="1.5"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
>
	{
		secteur === 'industrie' && (
			<>
				{/* Atelier : toit en dents de scie, lisible même en petit */}
				<path d="M7 38V22l7-6v6l7-6v6l7-6v6l7-6v22" />
				<path d="M4 38h40" />
				<path d="M14 38v-7h6v7M28 38v-7h6v7" />
			</>
		)
	}
	{
		secteur === 'agriculture' && (
			<>
				{/* Pousse et sillons */}
				<path d="M24 34V20" />
				<path d="M24 22c0-4 3-7 7-7 0 4-3 7-7 7Z" />
				<path d="M24 26c0-4-3-7-7-7 0 4 3 7 7 7Z" />
				<path d="M8 38h32M11 34h9M28 34h9" />
			</>
		)
	}
	{
		secteur === 'recherche' && (
			<>
				{/* Atome : laboratoire et recherche */}
				<circle cx="24" cy="24" r="3" />
				<ellipse cx="24" cy="24" rx="15" ry="6" />
				<ellipse cx="24" cy="24" rx="15" ry="6" transform="rotate(60 24 24)" />
				<ellipse cx="24" cy="24" rx="15" ry="6" transform="rotate(120 24 24)" />
			</>
		)
	}
	{
		secteur === 'bancs-de-test' && (
			<>
				{/* Cadran de mesure */}
				<path d="M8 30a16 16 0 0 1 32 0" />
				<path d="M24 30l9-7" />
				<circle cx="24" cy="30" r="2" />
				<path d="M8 30h4M36 30h4M12.5 18.5l2.8 2.8M35.5 18.5l-2.8 2.8M24 14v4" />
				<path d="M8 36h32" />
			</>
		)
	}
	{
		secteur === 'tertiaire' && (
			<>
				{/* Borne interactive */}
				<rect x="14" y="8" width="20" height="26" rx="2" />
				<path d="M18 14h12M18 19h12M18 24h7" />
				<path d="M24 34v6M16 40h16" />
			</>
		)
	}
</svg>
