---
// Visionneuse d'un modèle glTF (.glb).
//
// Le modèle se charge quand il approche de l'écran, jamais avant. `interactif` : sur une
// fiche, le visiteur tourne et zoome lui-même ; sur une carte ou dans une liste, le modèle
// tourne seul et ne capte pas la souris, pour ne pas gêner le défilement de la page ou du
// carrousel.
//
// La bibliothèque elle-même est chargée par src/scripts/visionneuse.ts, à appeler dans le
// script de la page qui utilise ce composant.
interface Props {
	src: string;
	nom: string;
	interactif?: boolean;
}
const { src, nom, interactif = true } = Astro.props;

// Pour un élément personnalisé, un attribut présent vaut « vrai » quelle que soit sa valeur :
// on n'écrit que ceux qui s'appliquent.
const commande = interactif
	? { 'camera-controls': true }
	: { 'auto-rotate': true, 'auto-rotate-delay': '0', 'rotation-per-second': '12deg' };
---

<model-viewer
	class="modele"
	src={src}
	alt={`Modèle en trois dimensions : ${nom}`}
	{...commande}
	touch-action="pan-y"
	loading="lazy"
	reveal="auto"
	environment-image="neutral"
	shadow-intensity="1"
	shadow-softness="0.7"
	exposure="0.9"
	interaction-prompt="none"
>
	<div slot="poster" class="modele__attente">Chargement du modèle…</div>
	<p slot="progress-bar" hidden></p>
</model-viewer>

<style>
	.modele {
		display: block;
		width: 100%;
		height: 100%;
		min-height: 12rem;
		background: var(--gris-clair);
		border: 1px solid var(--gris-moyen);
		border-radius: var(--rayon);
	}
	.modele__attente {
		display: grid;
		place-items: center;
		height: 100%;
		font-family: var(--titres);
		font-size: 0.9rem;
		color: var(--gris-leger);
	}
</style>
