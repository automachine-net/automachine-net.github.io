---
// Visionneuse d'un modèle glTF (.glb) : rotation à la souris ou au doigt, zoom à la molette.
//
// `declenchement` : « auto », le modèle se charge quand il approche de l'écran (fiche
// machine) ; « interaction », il attend un clic ou un toucher (cartes et listes, où plusieurs
// modèles de plusieurs mégaoctets ne doivent pas se charger d'un coup).
//
// La bibliothèque elle-même est chargée par src/scripts/visionneuse.ts, à appeler dans le
// script de la page qui utilise ce composant.
interface Props {
	src: string;
	nom: string;
	declenchement?: 'auto' | 'interaction';
}
const { src, nom, declenchement = 'auto' } = Astro.props;
---

<model-viewer
	class="modele"
	src={src}
	alt={`Modèle en trois dimensions : ${nom}`}
	camera-controls
	touch-action="pan-y"
	loading="lazy"
	reveal={declenchement}
	shadow-intensity="0.6"
	exposure="1"
	interaction-prompt="none"
>
	<div slot="poster" class="modele__attente">
		{declenchement === 'interaction' ? (
			<span class="modele__bouton">Voir en 3D</span>
		) : (
			<span>Chargement du modèle…</span>
		)}
	</div>
	<p slot="progress-bar" hidden></p>
</model-viewer>

<style>
	.modele {
		display: block;
		width: 100%;
		height: 100%;
		min-height: 12rem;
		background: var(--gris-clair);
		border: 1px solid var(--gris-moyen);
		border-radius: var(--rayon);
	}
	.modele__attente {
		display: grid;
		place-items: center;
		height: 100%;
		font-family: var(--titres);
		color: var(--gris-leger);
		cursor: pointer;
	}
	.modele__bouton {
		font-weight: 600;
		font-size: 0.85rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--bleu);
		border: 1px solid var(--bleu);
		border-radius: var(--rayon);
		padding: 0.55rem 1rem;
		background: var(--blanc);
	}
</style>
