---
// Coordonnées directes, en tête de la page Contact.
//
// Tant que le formulaire attend l'hébergement définitif, le téléphone est le moyen le plus
// court de nous joindre : il vient donc avant le formulaire, en grand, et pas seulement dans
// le pied de page. Le jour où le formulaire est en service, le bloc garde son sens.
//
// L'adresse électronique n'est affichée que si elle est renseignée dans les réglages : elle
// reste vide tant que le dépôt du site est public.
import site from '../../content/reglages/site.json';
const numero = site.telephone.replace(/\s/g, '');
---

<section class="bloc bloc--blanc">
	<div class="bloc__interieur coordonnees">
		<div class="coordonnees__entree">
			<p class="coordonnees__libelle">Par téléphone</p>
			<a class="coordonnees__numero" href={`tel:${numero}`}>{site.telephone}</a>
		</div>
		<div class="coordonnees__entree">
			<p class="coordonnees__libelle">Par courrier</p>
			<address class="coordonnees__adresse">
				{site.adresse_voie}<br />
				{site.adresse_code_postal} {site.adresse_ville}
			</address>
		</div>
		{
			site.email && (
				<div class="coordonnees__entree">
					<p class="coordonnees__libelle">Par courriel</p>
					<a href={`mailto:${site.email}`}>{site.email}</a>
				</div>
			)
		}
		{
			site.linkedin && (
				<div class="coordonnees__entree">
					<p class="coordonnees__libelle">Sur LinkedIn</p>
					<a href={site.linkedin} rel="noopener">Page du dirigeant</a>
				</div>
			)
		}
	</div>
</section>

<style>
	.coordonnees {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
		gap: 1.5rem 2.5rem;
		padding-top: 0.5rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--gris-moyen);
		margin-bottom: 1.5rem;
	}
	.coordonnees__libelle {
		margin: 0 0 0.25rem;
		font-family: var(--titres);
		font-weight: 500;
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--bleu);
	}
	.coordonnees__numero {
		display: inline-block;
		font-family: var(--titres);
		font-weight: 600;
		font-size: clamp(1.5rem, 3vw, 2rem);
		line-height: 1.1;
		color: var(--bleu-nuit);
		text-decoration: none;
		border-bottom: 2px solid var(--orange);
		padding-bottom: 0.15rem;
	}
	.coordonnees__numero:hover {
		color: var(--bleu);
	}
	.coordonnees__adresse {
		font-style: normal;
		line-height: 1.5;
	}
</style>
