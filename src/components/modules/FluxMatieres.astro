---
// Module « Circulation des matières » — schéma de flux animé, pilotable au clavier.
//
// Conçu pour deux usages : la page publique, où l'on avance à son rythme, et la conférence,
// où l'orateur commande les étapes sans souris et projette en plein écran.
//
// Le dessin est original : seules les valeurs sont reprises de la publication du SDES, citées
// en pied de module. Chaque bande a une épaisseur proportionnelle à sa valeur, tracée comme
// un trait épais plutôt que comme une forme fermée — c'est la même chose à l'œil, et cela
// tient en une ligne par flux.
//
// La publication d'origine ne se referme pas exactement (arrondis et variations de stock,
// une vingtaine de millions de tonnes). Ce n'est pas corrigé ici : les valeurs affichées sont
// celles publiées. L'écart relève du suivi interne (note du JSON, CLAUDE.md) : il ne
// s'affiche pas sur le site.
import donnees from '../../../content/donnees/flux-matieres.json';
import { typo } from '../../scripts/typographie';

interface Props {
	/** Titre de niveau 2 au-dessus du schéma. Absent, le module s'insère sans titre. */
	titre?: string;
}
const { titre } = Astro.props;

const valeur = (cle: string): number =>
	donnees.flux.find((f) => f.cle === cle)?.valeur ?? 0;
const libelle = (cle: string): string =>
	donnees.flux.find((f) => f.cle === cle)?.libelle ?? cle;

const TOTAL = valeur('apports');

/** Millions de tonnes → unités du dessin. */
const ECHELLE = 0.3;
const ep = (cle: string) => Math.max(valeur(cle) * ECHELLE, 3);

const nombre = (v: number) => v.toLocaleString('fr-FR', { minimumFractionDigits: 1 });
const part = (v: number) => Math.round((v / TOTAL) * 100);

/** Bande courbe entre deux points, chacun repéré par le centre de la bande. */
const bande = (x1: number, y1: number, x2: number, y2: number) => {
	const m = (x1 + x2) / 2;
	return `M ${x1},${y1} C ${m},${y1} ${m},${y2} ${x2},${y2}`;
};

// ─── Géométrie ────────────────────────────────────────────────────────────────────────
// Les ordonnées sont des centres de bande. Les piles verticales ont été calculées à partir
// des épaisseurs ci-dessus : modifier une valeur du JSON demande de reprendre ce bloc.

const APPORTS = { x: 430, l: 16, haut: 110, bas: 402.4 };
const UTILISATION = { x: 800, l: 16, haut: 560, bas: 757.3 };
const TRAITEMENT = { x: 1100, l: 16, haut: 560, bas: 641.4 };
const AIR = { x: 1300, l: 16, haut: 300, bas: 395.7 };
const XT = 1300; // abscisse des extrémités de droite
const LT = 16; // largeur d'une barre d'extrémité

type Flux = {
	cle: string;
	nature: 'entree' | 'interne' | 'perte' | 'boucle' | 'stock' | 'sortie';
	d: string;
	/** Épaisseur, en unités du dessin. */
	e: number;
};

const flux: Flux[] = [
	// Les entrées démarrent à 260 pour laisser, à leur gauche, la place de leurs étiquettes :
	// posées sur la bande, elles ne contrastaient pas assez (2,85 : 1).
	{ cle: 'importations', nature: 'entree', e: ep('importations'), d: bande(260, 106, APPORTS.x, 161.2) },
	{ cle: 'extraction', nature: 'entree', e: ep('extraction'), d: bande(260, 340, APPORTS.x, 307.4) },

	{ cle: 'exportations', nature: 'sortie', e: ep('exportations'), d: bande(APPORTS.x + APPORTS.l, 140.3, XT, 95) },
	{ cle: 'dissipatifs', nature: 'perte', e: ep('dissipatifs'), d: bande(APPORTS.x + APPORTS.l, 178.7, XT, 205) },
	{
		cle: 'emissions_hors_incineration',
		nature: 'perte',
		e: ep('emissions_hors_incineration'),
		d: bande(APPORTS.x + APPORTS.l, 231.7, AIR.x, 345),
	},
	{
		cle: 'vers_utilisation',
		nature: 'interne',
		e: 419.3 * ECHELLE,
		d: bande(APPORTS.x + APPORTS.l, 339.5, UTILISATION.x, 625.9),
	},

	{ cle: 'traitement', nature: 'interne', e: ep('traitement'), d: bande(UTILISATION.x + UTILISATION.l, 600.7, TRAITEMENT.x, 600.7) },
	{ cle: 'accumulation', nature: 'stock', e: ep('accumulation'), d: bande(UTILISATION.x + UTILISATION.l, 699.4, XT, 720) },

	// L'eau part du même point que l'incinération et s'en détache en chemin : dessinée
	// avant, elle est recouverte à l'origine et n'apparaît qu'où elle diverge.
	{ cle: 'eau', nature: 'perte', e: ep('eau'), d: bande(TRAITEMENT.x + TRAITEMENT.l, 561.5, XT, 430) },
	{ cle: 'incineration', nature: 'perte', e: ep('incineration'), d: bande(TRAITEMENT.x + TRAITEMENT.l, 563.2, AIR.x, 392.5) },
	{ cle: 'enfouis', nature: 'perte', e: ep('enfouis'), d: bande(TRAITEMENT.x + TRAITEMENT.l, 571.2, XT, 520) },

	// Les deux boucles repassent sous le schéma. Le remblayage sort plus haut et boucle plus
	// court que le recyclage : ainsi les deux trajets ne se croisent jamais.
	{
		cle: 'remblayage',
		nature: 'boucle',
		e: ep('remblayage'),
		d: `M ${TRAITEMENT.x + TRAITEMENT.l},581.1 C 1160,581.1 1175,620 1175,700 C 1175,780 1130,818 1060,818 L 900,818 C 820,818 775,800 772,750 C 770,712 775,693.9 ${UTILISATION.x},693.9`,
	},
	{
		cle: 'recyclage',
		nature: 'boucle',
		e: ep('recyclage'),
		d: `M ${TRAITEMENT.x + TRAITEMENT.l},613.8 C 1210,613.8 1235,660 1235,732 C 1235,860 1170,900 1080,900 L 900,900 C 800,900 728,866 725,782 C 722,732 745,726.6 ${UTILISATION.x},726.6`,
	},
];

/** Barres sombres des nœuds et des extrémités. */
const noeuds = [
	{ x: APPORTS.x, y: APPORTS.haut, h: APPORTS.bas - APPORTS.haut, l: APPORTS.l },
	{ x: UTILISATION.x, y: UTILISATION.haut, h: UTILISATION.bas - UTILISATION.haut, l: UTILISATION.l },
	{ x: TRAITEMENT.x, y: TRAITEMENT.haut, h: TRAITEMENT.bas - TRAITEMENT.haut, l: TRAITEMENT.l },
	{ x: AIR.x, y: AIR.haut, h: AIR.bas - AIR.haut, l: AIR.l },
	{ x: XT, y: 95 - ep('exportations') / 2, h: ep('exportations'), l: LT },
	{ x: XT, y: 205 - ep('dissipatifs') / 2, h: ep('dissipatifs'), l: LT },
	{ x: XT, y: 430 - ep('eau') / 2, h: ep('eau'), l: LT },
	{ x: XT, y: 520 - ep('enfouis') / 2, h: ep('enfouis'), l: LT },
	{ x: XT, y: 720 - ep('accumulation') / 2, h: ep('accumulation'), l: LT },
];

/** Étiquettes. `lignes` permet de couper un libellé long sans dépendre du rendu. */
type Etiquette = {
	cles: string[];
	x: number;
	y: number;
	ancre: 'start' | 'middle' | 'end';
	valeurCle: string;
	lignes: string[];
	/** Étiquette posée sur une bande claire : le texte y est plus petit. */
	sur?: boolean;
};

const etiquettes: Etiquette[] = [
	{ cles: ['importations'], x: 244, y: 96, ancre: 'end', valeurCle: 'importations', lignes: ['Importations'] },
	{ cles: ['extraction'], x: 244, y: 318, ancre: 'end', valeurCle: 'extraction', lignes: ['Extraction', 'intérieure'] },
	{ cles: ['importations', 'extraction', 'apports'], x: APPORTS.x + APPORTS.l + 10, y: 44, ancre: 'start', valeurCle: 'apports', lignes: ['Apports directs', 'de matières'] },

	{ cles: ['exportations'], x: XT + 26, y: 82, ancre: 'start', valeurCle: 'exportations', lignes: ['Exportations'] },
	{ cles: ['dissipatifs'], x: XT + 26, y: 192, ancre: 'start', valeurCle: 'dissipatifs', lignes: ['Flux dissipatifs'] },
	{ cles: ['emissions_hors_incineration'], x: 830, y: 268, ancre: 'middle', valeurCle: 'emissions_hors_incineration', lignes: ['Émissions hors', 'incinération des déchets'], sur: true },
	{ cles: ['emissions_hors_incineration', 'incineration', 'air'], x: XT + 26, y: 325, ancre: 'start', valeurCle: 'air', lignes: ['Émissions', 'dans l’air'] },
	{ cles: ['eau'], x: XT + 26, y: 417, ancre: 'start', valeurCle: 'eau', lignes: ['Émissions dans l’eau'] },
	{ cles: ['enfouis'], x: XT + 26, y: 507, ancre: 'start', valeurCle: 'enfouis', lignes: ['Déchets enfouis'] },
	{ cles: ['accumulation'], x: XT + 26, y: 707, ancre: 'start', valeurCle: 'accumulation', lignes: ['Accumulation', 'de matières'] },

	// Ces deux étiquettes sont posées sur le blanc, juste au-dessus de leur bande : dessus,
	// elles ne contrastaient pas assez.
	// Position vérifiée par calcul de collision dans le navigateur (isPointInStroke sur
	// toutes les bandes) : libre avec 24 unités de marge, sous la bande et loin des boucles.
	{ cles: ['utilisation', 'vers_utilisation'], x: 588, y: 592, ancre: 'end', valeurCle: 'utilisation', lignes: ['Utilisation', 'de matières'] },
	{ cles: ['traitement'], x: 958, y: 520, ancre: 'middle', valeurCle: 'traitement', lignes: ['Traitement des déchets'] },
	{ cles: ['incineration'], x: 1132, y: 545, ancre: 'start', valeurCle: 'incineration', lignes: ['Incinération'] },
	{ cles: ['remblayage'], x: 980, y: 810, ancre: 'middle', valeurCle: 'remblayage', lignes: ['Remblayage'], sur: true },
	{ cles: ['recyclage'], x: 980, y: 892, ancre: 'middle', valeurCle: 'recyclage', lignes: ['Recyclage'], sur: true },
];

// ─── Étapes ───────────────────────────────────────────────────────────────────────────
const etapes = donnees.etapes.map((e, i) => {
	const v = e.chiffre ? valeur(e.chiffre) : null;
	const cumul = 'cumul' in e && Array.isArray(e.cumul)
		? (e.cumul as string[]).reduce((s, c) => s + valeur(c), 0)
		: null;
	return {
		index: i,
		cle: e.cle,
		titre: typo(e.titre),
		commentaire: typo(e.commentaire),
		// Une étape sans flux nommé les allume tous : c'est la vue d'ensemble.
		actifs: e.actifs.length ? e.actifs : flux.map((f) => f.cle),
		valeur: v,
		libelleValeur: e.chiffre ? libelle(e.chiffre) : null,
		pourcentage: v === null ? null : part(v),
		cumul,
		cumulPourcentage: cumul === null ? null : part(cumul),
		cumulLibelle: 'cumul_libelle' in e ? typo(String(e.cumul_libelle)) : null,
	};
});
---

<figure class="flux" data-flux-module data-etape="0">
	<!-- Bandeau : ce qu'on regarde, dans quelle unité, et où l'on en est. -->
	<header class="flux__entete">
		<p class="flux__quoi">{typo(donnees.titre)}</p>
		<ol class="flux__jalons">
			{
				etapes.map((e) => (
					<li>
						<button type="button" data-jalon={e.index} aria-label={e.titre}>
							<span aria-hidden="true" />
						</button>
					</li>
				))
			}
		</ol>
	</header>

	<!-- Scène : le schéma au centre, une flèche de chaque côté. -->
	<div class="flux__scene">
		<button type="button" class="flux__fleche flux__fleche--scene" data-precedent aria-label="Étape précédente">
			<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 12H4M11 5l-7 7 7 7" /></svg>
		</button>
		<svg
			class="flux__dessin"
			viewBox="0 0 1700 960"
			role="img"
			aria-labelledby="flux-titre-svg"
			preserveAspectRatio="xMidYMid meet"
		>
			<title id="flux-titre-svg">
				{typo(`${donnees.titre}, ${donnees.annee}, en ${donnees.unite}.`)}
			</title>

			<g class="flux__bandes">
				{
					flux.map((f) => (
						<g class="flux__flux" data-flux={f.cle} data-nature={f.nature}>
							<path class="flux__bande" d={f.d} stroke-width={f.e} />
							<path class="flux__mouvement" d={f.d} stroke-width={f.e} />
						</g>
					))
				}
			</g>

			<g class="flux__noeuds">
				{noeuds.map((n) => <rect x={n.x} y={n.y} width={n.l} height={n.h} rx="1" />)}
			</g>

			<g class="flux__etiquettes">
				{
					etiquettes.map((et) => (
						<g
							class={`flux__etiquette ${et.sur ? 'flux__etiquette--sur' : ''}`}
							data-etiquette={et.cles.join(' ')}
						>
							<text x={et.x} y={et.y} text-anchor={et.ancre}>
								<tspan class="flux__valeur">{nombre(valeur(et.valeurCle))}</tspan>
								{et.lignes.map((l, i) => (
									<tspan x={et.x} dy={i === 0 ? 26 : 24} class="flux__nom">
										{l}
									</tspan>
								))}
							</text>
						</g>
					))
				}
			</g>
		</svg>
		<button type="button" class="flux__fleche flux__fleche--scene" data-suivant aria-label="Étape suivante">
			<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 12h16M13 5l7 7-7 7" /></svg>
		</button>
	</div>

	<!-- L'étape : titre, chiffre et commentaire, ensemble, sous le schéma. -->
	<div class="flux__etape">
		<h3 class="flux__titre-etape" data-titre>{etapes[0].titre}</h3>
		<p class="flux__nombre" data-nombre hidden></p>
		<p class="flux__commentaire" data-commentaire>{etapes[0].commentaire}</p>
		<p class="flux__cumul" data-cumul hidden></p>
	</div>

	<!-- Coin inférieur : l'aide derrière un « ? », le plein écran, et en plein écran les
	     flèches, pour ne rien laisser au milieu qui gêne la lecture. -->
	<div class="flux__coin">
		<!-- L'aide apparaît au survol ou à la prise de focus, sans clic. -->
		<span class="flux__aide" tabindex="0" aria-describedby="flux-aide-texte">
			<span class="flux__aide-rond" aria-hidden="true">?</span>
			<span class="flux__aide-texte" id="flux-aide-texte" role="tooltip">
				{typo('Flèches ← et → du clavier, ou barre d’espace. Touche Début pour revenir au départ.')}
			</span>
		</span>
		<button type="button" class="flux__plein-ecran" data-plein-ecran>
			<span data-plein-ecran-texte>Plein écran</span>
		</button>
		<button type="button" class="flux__fleche flux__fleche--coin" data-precedent aria-label="Étape précédente">
			<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 12H4M11 5l-7 7 7 7" /></svg>
		</button>
		<button type="button" class="flux__fleche flux__fleche--coin" data-suivant aria-label="Étape suivante">
			<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 12h16M13 5l7 7-7 7" /></svg>
		</button>
	</div>

	<figcaption class="flux__source">
		<strong>Source&#8239;:</strong> {typo(donnees.source)}
	</figcaption>
</figure>

<script is:inline define:vars={{ etapes }}>
	(() => {
		const module = document.querySelector('[data-flux-module]');
		if (!module) return;

		const titre = module.querySelector('[data-titre]');
		const nombre = module.querySelector('[data-nombre]');
		const commentaire = module.querySelector('[data-commentaire]');
		const cumul = module.querySelector('[data-cumul]');
		const jalons = [...module.querySelectorAll('[data-jalon]')];
		const bandes = [...module.querySelectorAll('[data-flux]')];
		const etiquettes = [...module.querySelectorAll('[data-etiquette]')];

		let courante = -1;

		function afficher(i) {
			const n = etapes.length;
			const index = ((i % n) + n) % n;
			if (index === courante) return;
			courante = index;
			const e = etapes[index];
			const actifs = new Set(e.actifs);

			module.dataset.etape = String(index);
			titre.textContent = e.titre;
			commentaire.textContent = e.commentaire;

			// Le bloc du chiffre garde toujours la même structure d'une étape chiffrée à l'autre,
			// pour que les textes ne bougent pas. La part n'a de sens que rapportée à l'entrée :
			// rendue invisible, non retirée, pour l'entrée. Sur une étape sans chiffre (la vue
			// d'ensemble), le bloc disparaît et le commentaire remonte sous le titre.
			const v = e.valeur === null ? etapes[0].valeur : e.valeur;
			const p = e.pourcentage === null ? 100 : e.pourcentage;
			nombre.hidden = e.valeur === null;
			nombre.innerHTML =
				'<span class="flux__nombre-valeur">' +
				v.toLocaleString('fr-FR', { minimumFractionDigits: 1 }) +
				'</span> <span class="flux__nombre-unite">millions de tonnes par an</span>' +
				'<span class="flux__nombre-part' +
				(p < 100 ? '' : ' est-invisible') +
				'">' +
				p +
				' % de ce qui entre</span>';

			// Même principe pour le cumul : sa place est réservée à toutes les étapes.
			const cumulModele = etapes.find((x) => x.cumul !== null);
			cumul.hidden = false;
			cumul.classList.toggle('est-invisible', e.cumul === null);
			const c = e.cumul === null ? cumulModele : e;
			cumul.innerHTML = c
				? '<strong>' + c.cumulPourcentage + ' %</strong> ' + c.cumulLibelle
				: '';

			bandes.forEach((b) => b.classList.toggle('est-actif', actifs.has(b.dataset.flux)));
			etiquettes.forEach((et) =>
				et.classList.toggle(
					'est-actif',
					et.dataset.etiquette.split(' ').some((c) => actifs.has(c))
				)
			);
			jalons.forEach((j, k) => j.setAttribute('aria-current', k === index ? 'true' : 'false'));
		}

		// Les flèches existent en deux jeux (côtés du schéma, coin en plein écran) : un seul
		// des deux est visible à la fois, les deux sont branchés.
		module.querySelectorAll('[data-precedent]').forEach((b) => b.addEventListener('click', () => afficher(courante - 1)));
		module.querySelectorAll('[data-suivant]').forEach((b) => b.addEventListener('click', () => afficher(courante + 1)));
		jalons.forEach((j) => j.addEventListener('click', () => afficher(Number(j.dataset.jalon))));

		// Plein écran : l'orateur projette le module seul, sans le reste de la page.
		const boutonPlein = module.querySelector('[data-plein-ecran]');
		const textePlein = module.querySelector('[data-plein-ecran-texte]');
		if (document.fullscreenEnabled) {
			boutonPlein.addEventListener('click', () => {
				if (document.fullscreenElement) document.exitFullscreen();
				else module.requestFullscreen();
			});
			document.addEventListener('fullscreenchange', () => {
				const actif = document.fullscreenElement === module;
				textePlein.textContent = actif ? 'Quitter le plein écran' : 'Plein écran';
			});
		} else {
			boutonPlein.hidden = true;
		}

		// Le clavier ne prend la main que si le module est à l'écran : sinon les flèches
		// doivent continuer à faire défiler la page. Le seuil est bas à dessein : sur un
		// écran peu haut, le module dépasse la fenêtre et n'est jamais visible en entier.
		let visible = false;
		new IntersectionObserver(
			(entrees) => entrees.forEach((e) => (visible = e.isIntersecting)),
			{ threshold: 0.15 }
		).observe(module);

		addEventListener('keydown', (ev) => {
			if (!visible && document.fullscreenElement !== module) return;
			const cible = ev.target;
			if (cible instanceof HTMLElement && cible.closest('input, textarea, select')) return;
			if (ev.key === 'ArrowRight' || ev.key === ' ' || ev.key === 'PageDown') {
				ev.preventDefault();
				afficher(courante + 1);
			} else if (ev.key === 'ArrowLeft' || ev.key === 'PageUp') {
				ev.preventDefault();
				afficher(courante - 1);
			} else if (ev.key === 'Home') {
				ev.preventDefault();
				afficher(0);
			}
		});

		afficher(0);
	})();
</script>

<style>
	/* ── Squelette ────────────────────────────────────────────────────────────────
	   Bandeau, scène, étape, coin, source, en colonne. Le schéma est borné en hauteur pour
	   que tout tienne à l'écran, légende comprise : c'est le schéma qui s'adapte, pas le
	   texte. */
	.flux {
		margin: 0;
		display: grid;
		/* Dernier rang : la source à gauche, les commandes à droite, sur la même ligne. */
		grid-template-columns: minmax(0, 1fr) auto;
		grid-template-areas:
			'entete entete'
			'scene scene'
			'etape etape'
			'source coin';
		gap: 1rem;
		background: var(--blanc);
		border: 1px solid var(--gris-moyen);
		border-radius: var(--rayon);
		padding: 1.25rem 1.5rem 1rem;
		position: relative;
	}
	.flux__entete {
		grid-area: entete;
	}
	.flux__scene {
		grid-area: scene;
	}
	.flux__etape {
		grid-area: etape;
	}
	.flux__coin {
		grid-area: coin;
	}
	.flux__source {
		grid-area: source;
		align-self: center;
	}
	.flux__coin {
		align-self: center;
	}

	/* ── Bandeau : titre centré, jalons centrés juste dessous ─────────────────── */
	.flux__entete {
		display: grid;
		justify-items: center;
		text-align: center;
		gap: 0.25rem;
	}
	.flux__quoi {
		margin: 0;
		font-family: var(--titres);
		font-weight: 600;
		color: var(--bleu-nuit);
		font-size: 1.15rem;
	}
	.flux__jalons {
		list-style: none;
		display: flex;
		gap: 0.35rem;
		margin: 0;
		padding: 0;
	}
	.flux__jalons button {
		display: block;
		padding: 0.5rem 0.1rem;
		border: 0;
		background: none;
		cursor: pointer;
	}
	.flux__jalons span {
		display: block;
		width: 1.3rem;
