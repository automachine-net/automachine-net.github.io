---
// Compte à rebours vers l'application du règlement (UE) 2023/1230.
// Sans JavaScript, la date reste lisible : seul le nombre de jours manque.
const ECHEANCE = '2027-01-20';
---

<div class="compte" data-echeance={ECHEANCE}>
	<p class="compte__valeur">
		<span data-jours>—</span>
		<span class="compte__unite">jours restants</span>
	</p>
	<p class="compte__legende">
		avant le <strong>20 janvier 2027</strong>, date d’application du règlement (UE) 2023/1230 qui
		remplace la directive 2006/42/CE.
	</p>
</div>

<script>
	for (const el of document.querySelectorAll<HTMLElement>('[data-echeance]')) {
		const cible = new Date(el.dataset.echeance + 'T00:00:00');
		const jours = Math.ceil((cible.getTime() - Date.now()) / 86_400_000);
		const sortie = el.querySelector('[data-jours]');
		if (sortie && jours > 0) sortie.textContent = String(jours);
	}
</script>

<style>
	.compte {
		background: var(--bleu-nuit);
		color: var(--blanc);
		padding: 1.75rem 2rem;
		border-radius: var(--rayon);
	}
	/* Le nombre seul n'intrigue pas : c'est « 139 jours restants » qui arrête le regard. */
	.compte__valeur {
		font-family: var(--titres);
		font-weight: 700;
		font-size: clamp(2.4rem, 7vw, 4.5rem);
		line-height: 1.05;
		color: var(--orange);
		margin: 0;
		display: flex;
		align-items: baseline;
		gap: 0.4em;
		flex-wrap: wrap;
	}
	.compte__unite {
		color: var(--blanc);
	}
	.compte__legende {
		margin: 0.6rem 0 0;
		font-size: 1.05rem;
		color: var(--blanc);
		max-width: 46rem;
	}
	.compte__legende strong {
		color: var(--bleu-clair);
	}
</style>
