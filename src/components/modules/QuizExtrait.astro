---
// Extrait jouable du quiz sur le règlement machines.
// Les questions viennent de content/quiz/reglement-machines.json, éditable dans le CMS.
// Le retour est immédiat au clic : bonne réponse en bleu, réponse choisie fausse en orange,
// puis l'explication et la référence d'article.
import quiz from '../../../content/quiz/reglement-machines.json';
import { lienArticle, libelleArticle } from '../../scripts/reglement';

interface Props {
	nombre?: number;
	/** Identifiants des questions à montrer. Sinon, une par thème, les plus courtes. */
	questions?: number[];
	/** Libellé du bouton qui déroule les questions. */
	libelle?: string;
	/** Lien vers le quiz complet, affiché sous les questions. */
	lien_libelle?: string;
	lien_url?: string;
}

const {
	nombre = 3,
	questions: choisies,
	libelle = 'Répondre au quiz',
	lien_libelle,
	lien_url,
} = Astro.props;

const selection = choisies?.length
	? choisies.map((id) => quiz.questions.find((q) => q.id === id)!).filter(Boolean)
	: (() => {
			// Une question par thème, la plus courte, pour rester lisible sur un téléphone.
			const parTheme = new Map<string, (typeof quiz.questions)[number]>();
			for (const q of [...quiz.questions].sort((a, b) => a.question.length - b.question.length)) {
				if (!parTheme.has(q.theme)) parTheme.set(q.theme, q);
			}
			return [...parTheme.values()].sort((a, b) => a.id - b.id).slice(0, nombre);
		})();

const lettres = ['a', 'b', 'c', 'd'] as const;
const article = (r: string) => r.replace(/^art\.\s*/i, 'article ');
---

{/* <details> : le quiz est replié à l'arrivée et se déroule au clic. Cela fonctionne sans
    JavaScript, la balise est prévue pour ça. */}
<details class="quiz" data-quiz>
	<summary class="quiz__bouton">
		<span>{libelle}</span>
	</summary>

	<ol class="quiz__liste">
		{
			selection.map((q) => (
				<li class="question" data-bonne={q.bonne_reponse}>
					<p class="question__texte">{q.question}</p>
					<div class="question__options" role="group" aria-label="Réponses possibles">
						{lettres.map((l) => (
							<button type="button" class="option" data-lettre={l}>
								<span class="option__lettre">{l.toUpperCase()}</span>
								<span>{q.options[l]}</span>
							</button>
						))}
					</div>
					<p class="question__explication" hidden>
						<strong data-verdict />
						{q.explication}
						<a class="reference" href={lienArticle(q.reference)} rel="noopener" target="_blank">
										Règlement machines (UE) 2023/1230, {libelleArticle(q.reference)}
									</a>
					</p>
				</li>
			))
		}
	</ol>

	{
		lien_url && (
			<p class="quiz__suite">
				<a class="bouton" href={lien_url}>
					{lien_libelle ?? 'Continuer'}
				</a>
			</p>
		)
	}

	<p class="quiz__mention">{quiz.mention}</p>
</details>

<script>
	document.querySelectorAll<HTMLElement>('[data-quiz] .question').forEach((q) => {
		const bonne = q.dataset.bonne;
		const options = q.querySelectorAll<HTMLButtonElement>('.option');
		const explication = q.querySelector<HTMLElement>('.question__explication');
		const verdict = explication?.querySelector<HTMLElement>('[data-verdict]');
		if (!explication || !verdict) return;

		options.forEach((choix) =>
			choix.addEventListener('click', () => {
				if (q.classList.contains('repondue')) return;
				q.classList.add('repondue');
				const juste = choix.dataset.lettre === bonne;
				options.forEach((autre) => {
					autre.disabled = true;
					if (autre.dataset.lettre === bonne) autre.classList.add('option--bonne');
					else if (autre === choix) autre.classList.add('option--fausse');
				});
				verdict.textContent = juste ? 'Exact. ' : `Non, la bonne réponse est ${bonne!.toUpperCase()}. `;
				explication.hidden = false;
			})
		);
	});
</script>

<style>
	/* Bouton de déroulement : c'est la balise <summary>, habillée en bouton. */
	.quiz__bouton {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		background: var(--bleu-nuit);
		color: var(--blanc);
		font-weight: 500;
		padding: 0.8rem 1.4rem;
		border-radius: var(--rayon);
		cursor: pointer;
		list-style: none;
	}
	.quiz__bouton::-webkit-details-marker {
		display: none;
	}
	.quiz__bouton::after {
		content: '';
		width: 0.55rem;
		height: 0.55rem;
		border-right: 2px solid currentColor;
		border-bottom: 2px solid currentColor;
		transform: translateY(-0.15rem) rotate(45deg);
		transition: transform 0.2s;
	}
	.quiz[open] .quiz__bouton::after {
		transform: translateY(0.1rem) rotate(-135deg);
	}
	.quiz__bouton:hover {
		background: var(--bleu);
	}

	/* Sur un bloc sombre, le bouton et les textes doivent s'inverser : le bleu nuit sur
	   bleu nuit serait invisible. */
	:global(.bloc--sombre) .quiz__bouton {
		background: var(--blanc);
		color: var(--bleu-nuit);
	}
	:global(.bloc--sombre) .quiz__bouton:hover {
		background: var(--orange);
		color: var(--bleu-nuit);
	}
	:global(.bloc--sombre) .question__texte {
		color: var(--blanc);
	}
	:global(.bloc--sombre) .quiz__mention {
		color: var(--bleu-clair);
		border-top-color: rgba(255, 255, 255, 0.2);
	}

	.quiz__liste {
		list-style: none;
		padding: 0;
		margin: 2.5rem 0 0;
		display: grid;
		gap: 2.5rem;
	}
	.question__texte {
		font-size: 1.1rem;
		font-weight: 500;
		color: var(--bleu-nuit);
		max-width: 70ch;
	}
	/* Deux colonnes dès qu'il y a la place : les quatre réponses forment un carré,
	   jamais trois sur une ligne et une seule en dessous. */
	.question__options {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.6rem;
	}
	@media (min-width: 680px) {
		.question__options {
			grid-template-columns: 1fr 1fr;
		}
	}
	.option {
		display: grid;
		grid-template-columns: 1.75rem minmax(0, 1fr);
		gap: 0.6rem;
		align-items: start;
		text-align: left;
		background: var(--blanc);
		border: 1px solid var(--gris-moyen);
		border-radius: var(--rayon);
		padding: 0.7rem 0.9rem;
		cursor: pointer;
		color: var(--gris);
		line-height: 1.4;
		transition:
			border-color 0.15s,
			background 0.15s;
	}
	.option:hover:not(:disabled) {
		border-color: var(--bleu);
	}
	.option:disabled {
		cursor: default;
	}
	.option__lettre {
		font-family: var(--titres);
		font-weight: 700;
		color: var(--bleu);
	}
	.option--bonne {
		background: var(--bleu);
		border-color: var(--bleu);
		color: var(--blanc);
	}
	.option--bonne .option__lettre {
		color: var(--blanc);
	}
	.option--fausse {
		background: var(--orange);
		border-color: var(--orange);
		color: var(--bleu-nuit);
	}
	.option--fausse .option__lettre {
		color: var(--bleu-nuit);
	}
	/* Le fond de l'explication est clair : la couleur du texte doit être posée
	   explicitement, sinon elle hérite du blanc d'un bloc sombre et devient illisible. */
	.question__explication {
		margin: 0.9rem 0 0;
		padding: 0.9rem 1rem;
		background: var(--gris-clair);
		border-left: 3px solid var(--bleu);
		max-width: 75ch;
		color: var(--gris);
	}
	.question__explication strong {
		color: var(--bleu-nuit);
	}
	.reference {
		display: block;
		margin-top: 0.5rem;
		font-size: 0.85rem;
		color: var(--bleu);
		text-decoration-color: var(--orange);
	}
	.quiz__suite {
		margin: 2.5rem 0 0;
	}
	:global(.bloc--sombre) .quiz__suite .bouton {
		background: var(--blanc);
		color: var(--bleu-nuit);
	}
	:global(.bloc--sombre) .quiz__suite .bouton:hover {
		background: var(--orange);
		color: var(--bleu-nuit);
	}
	/* La mention obligatoire ferme le bloc, rattachée par un filet : elle ne flotte pas. */
	.quiz__mention {
		margin: 1.5rem 0 0;
		padding-top: 1rem;
		border-top: 1px solid var(--gris-moyen);
		font-size: 0.85rem;
		color: var(--gris-leger);
	}
</style>
