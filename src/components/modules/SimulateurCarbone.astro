---
// Simulateur d'empreinte carbone d'une machine spéciale.
//
// Les facteurs viennent de content/donnees/facteurs-carbone.json, sourcés ligne par ligne.
// Le calcul vit dans src/scripts/carbone.ts et tourne dans le navigateur : aucune donnée
// saisie ne quitte le poste du visiteur.
//
// Deux niveaux de saisie : « à la louche » par grande catégorie, ou détaillée par matériau.
// Sans détail, la fourchette est volontairement large — c'est ce qui rend visible le gain
// qu'apporte une saisie plus fine.
import facteurs from '../../../content/donnees/facteurs-carbone.json';
import { typo } from '../../scripts/typographie';

interface Props {
	/**
	 * Version réduite, pour poser le simulateur dans une page : pas de bascule d'unité,
	 * pas de détail par matériau, pas de liste d'hypothèses. Le nécessaire pour obtenir
	 * un ordre de grandeur, et un lien vers la version complète.
	 */
	compact?: boolean;
}
const { compact = false } = Astro.props;

/** Valeurs d'exemple, affichées en filigrane et reprises si le champ reste vide. */
const exemples = {
	kg: { metaux: 400, plastiques: 20, electrique: 80 },
	pct: { metaux: 80, plastiques: 4, electrique: 16 },
	masse: 500,
	puissance: 10,
	charge: 50,
	heures: 6000,
	duree: 20,
	distance: 300,
};

const aides: Record<string, string> = {
	metaux:
		'Le poste le plus lourd d’une machine, donc souvent le premier contributeur. À masse égale, l’aluminium émet plus de 3 fois l’acier : détailler cette catégorie change beaucoup le résultat.',
	plastiques:
		'Rarement déterminant, parce que les masses en jeu sont faibles. Les polymères courants se tiennent dans un rapport de 1 à 2.',
	electrique:
		'La catégorie la plus incertaine. À masse égale, l’électronique de commande émet 12 fois un moteur. Séparer les moteurs de l’armoire resserre nettement la fourchette.',
	masse: 'Sert à convertir les pourcentages en kilogrammes. Ne change rien à la répartition.',
	puissance:
		'Détermine la consommation, donc tout le poste « usage ». Si la machine est alimentée en air comprimé, ajoutez ici la puissance électrique du compresseur qui la dessert.',
	charge:
		'Une machine tourne rarement à pleine puissance. Ce taux multiplie directement la consommation : le passer de 50 à 100 % double le poste « usage ».',
	heures:
		'Multiplie la consommation. Une machine en 3 × 8 émet beaucoup plus, à puissance égale, qu’une machine utilisée quelques heures par semaine.',
	duree:
		'Allonger la durée de vie augmente la consommation totale, mais étale la fabrication sur davantage d’années. C’est le paramètre qui fait basculer le poids relatif des postes.',
	distance:
		'N’influence presque jamais le résultat : le transport d’une machine pèse moins de 1 % du total, même sur 1 000 km.',
};

const parametres = [
	{ cle: 'puissance', libelle: 'Puissance installée', unite: 'kW', pas: '0.5' },
	{ cle: 'charge', libelle: 'Taux de charge moyen', unite: '%', pas: '5' },
	{ cle: 'heures', libelle: 'Heures de fonctionnement', unite: 'h/an', pas: '100' },
	{ cle: 'duree', libelle: 'Durée de vie attendue', unite: 'ans', pas: '1' },
	{ cle: 'distance', libelle: 'Distance de livraison', unite: 'km', pas: '50' },
] as const;
---

<form class={`simulateur ${compact ? 'simulateur--compact' : ''}`} data-simulateur novalidate>
	<p class="sans-js">
		Le calcul se fait dans votre navigateur et demande JavaScript, que le vôtre semble ne pas
		exécuter. La méthode et les facteurs restent décrits plus bas.
	</p>

	<fieldset class="section">
		<legend>De quoi la machine est faite</legend>

		<div class="reglages" hidden={compact}>
			<div class="unite-bascule" role="group" aria-label="Unité de saisie">
				<button type="button" class="unite-bascule__choix est-actif" data-unite="kg">
					Kilogrammes
				</button>
				<button type="button" class="unite-bascule__choix" data-unite="pct">Pourcentage</button>
			</div>

			<div class="champ champ--masse" data-champ-masse hidden>
				<div class="champ__tete">
					<label for="masse">Masse totale</label>
					<span class="aide" data-aide data-bulle>
						<button type="button" class="aide-bouton" aria-describedby="aide-masse">
							<span aria-hidden="true">?</span>
							<span class="sr-only">Que change ce paramètre ?</span>
						</button>
						<span class="bulle" role="tooltip" id="aide-masse">{typo(aides.masse)}</span>
					</span>
				</div>
				<div class="saisie">
					<input
						type="number"
						id="masse"
						data-valeur="masse"
						placeholder={String(exemples.masse)}
						min="1"
						step="10"
					/>
					<span class="unite">kg</span>
				</div>
			</div>

			<div class="champ champ--ajustement" data-champ-ajustement hidden>
				<label for="ajustee">Catégorie qui complète à 100 %</label>
				<select id="ajustee" data-ajustee>
					{
						facteurs.categories.map((c) => (
							<option value={c.cle} selected={c.cle === 'plastiques'}>
								{c.libelle}
							</option>
						))
					}
					<option value="">Aucune, je saisis les trois</option>
				</select>
				<p class="aide-inline">
					Vous saisissez les deux autres, celle-ci est calculée pour que le total fasse 100 %.
				</p>
			</div>
		</div>

		<div class="categories">
			{
				facteurs.categories.map((c) => (
					<div class="categorie" data-categorie={c.cle}>
						<div class="categorie__tete">
							<span class="categorie__nom">
								<label for={`cat-${c.cle}`}>{c.libelle}</label>
								<span class="aide" data-aide data-bulle>
									<button type="button" class="aide-bouton" aria-describedby={`aide-${c.cle}`}>
										<span aria-hidden="true">?</span>
										<span class="sr-only">Que change ce paramètre ?</span>
									</button>
									<span class="bulle" role="tooltip" id={`aide-${c.cle}`}>
										{typo(aides[c.cle])}
									</span>
								</span>
							</span>
							<div class="saisie saisie--categorie">
								<input
									type="number"
									id={`cat-${c.cle}`}
									data-categorie-valeur={c.cle}
									placeholder={String(exemples.kg[c.cle as keyof typeof exemples.kg])}
									min="0"
									step="1"
								/>
								<span class="unite" data-unite-libelle>kg</span>
							</div>
							{!compact && (
								<button type="button" class="detailler" data-detailler={c.cle} aria-expanded="false">
									Afficher le détail
								</button>
							)}
						</div>

						<p class="exemples">{typo(c.aide)}</p>

						<div class="detail" data-detail={c.cle} hidden={true}>
							<p class="detail__consigne">
								Renseignez ce que vous connaissez. Les lignes laissées vides ne comptent pas.
							</p>
							<div class="detail__lignes">
								{c.sous.map((s) => (
									<div class="champ champ--sous">
										<span class="champ--sous__tete">
											<label for={`sous-${c.cle}-${s.cle}`}>{s.libelle}</label>
											{s.exemples && (
												<span class="aide" data-aide data-bulle>
													<button
														type="button"
														class="aide-bouton aide-bouton--petit"
														aria-describedby={`ex-${c.cle}-${s.cle}`}
													>
														<span aria-hidden="true">?</span>
														<span class="sr-only">Exemples</span>
													</button>
													<span class="bulle" role="tooltip" id={`ex-${c.cle}-${s.cle}`}>
														{typo(s.exemples)}
														{s.approche && <span class="bulle__note">{typo(s.note_courte)}</span>}
													</span>
												</span>
											)}
										</span>
										<div class="saisie">
											<input
												type="number"
												id={`sous-${c.cle}-${s.cle}`}
												data-sous={c.cle}
												data-sous-cle={s.cle}
												min="0"
												step="1"
												placeholder="0"
											/>
											<span class="unite" data-unite-libelle>kg</span>
										</div>
									</div>
								))}
							</div>
						</div>
					</div>
				))
			}
		</div>

		<p class="bilan" data-bilan aria-live="polite"></p>
	</fieldset>

	<fieldset class="section">
		<legend>Comment elle sera utilisée</legend>
		<div class="grille">
			{
				parametres.map((champ) => (
					<div class="champ" hidden={compact && champ.cle === 'distance'}>
						<div class="champ__tete">
							<label for={champ.cle}>{champ.libelle}</label>
							<span class="aide" data-aide data-bulle>
								<button type="button" class="aide-bouton" aria-describedby={`aide-${champ.cle}`}>
									<span aria-hidden="true">?</span>
									<span class="sr-only">Que change ce paramètre ?</span>
								</button>
								<span class="bulle" role="tooltip" id={`aide-${champ.cle}`}>
									{typo(aides[champ.cle])}
								</span>
							</span>
						</div>
						<div class="saisie">
							<input
								type="number"
								id={champ.cle}
								data-valeur={champ.cle}
								placeholder={String(exemples[champ.cle])}
								min="0"
								step={champ.pas}
							/>
							<span class="unite">{champ.unite}</span>
						</div>
					</div>
				))
			}
		</div>
	</fieldset>
</form>

<section class={`resultat ${compact ? 'resultat--compact' : ''}`} data-resultat hidden aria-live="polite">
	<h2>Ordre de grandeur</h2>
	<p class="fourchette">
		<span data-total-bas></span>
		<span class="fourchette__a">à</span>
		<span data-total-haut></span>
	</p>
	<ul class="comparaisons" data-comparaisons></ul>

	<div class="barre-bloc">
		<div class="barre" data-barre></div>
		<div class="barre__bulle" data-barre-bulle hidden></div>
	</div>
	<ul class="legende" data-legende></ul>

	{/* Reprise du détail sous forme de texte, pour les lecteurs d'écran. */}
	<ul class="sr-only" data-detail-postes></ul>

	<p class="note-fin-de-vie" hidden={compact}>{typo(facteurs.fin_de_vie.remarque)}</p>

	<details class="hypotheses" hidden={compact}>
		<summary>Hypothèses retenues pour ce calcul</summary>
		<ul data-hypotheses></ul>
	</details>
</section>

<script>
	import { calculer, formaterCO2e, arrondiParlant } from '../../scripts/carbone';
	import { typo } from '../../scripts/typographie';
	import { recalerLesBulles } from '../../scripts/bulle';

	const form = document.querySelector<HTMLFormElement>('[data-simulateur]');
	const resultat = document.querySelector<HTMLElement>('[data-resultat]');

	if (form && resultat) {
		form.classList.add('simulateur--actif');

		const CATEGORIES = ['metaux', 'plastiques', 'electrique'];
		const EXEMPLES = {
			kg: { metaux: 400, plastiques: 20, electrique: 80 },
			pct: { metaux: 80, plastiques: 4, electrique: 16 },
		};
		let unite: 'kg' | 'pct' = 'kg';

		const champ = (sel: string) => form.querySelector<HTMLInputElement>(sel)!;
		/** Valeur saisie, ou valeur d'exemple affichée en filigrane si le champ est vide. */
		const lire = (input: HTMLInputElement) =>
			input.value.trim() === '' ? Number(input.placeholder) || 0 : Number(input.value) || 0;

		// Les bulles doivent rester dans la page : le recalage est mutualisé.
		recalerLesBulles(form);


		// ---------------------------------------------------------- Détail des catégories
		form.querySelectorAll<HTMLButtonElement>('[data-detailler]').forEach((bouton) => {
			const panneau = form.querySelector<HTMLElement>(`[data-detail="${bouton.dataset.detailler}"]`)!;
			bouton.addEventListener('click', () => {
				const ouvert = panneau.hidden;
				panneau.hidden = !ouvert;
				bouton.setAttribute('aria-expanded', String(ouvert));
				bouton.textContent = ouvert ? 'Masquer le détail' : 'Afficher le détail';
				recalculer();
			});
		});

		// ---------------------------------------------------------- Kilogrammes ou pourcentage
		const champMasse = form.querySelector<HTMLElement>('[data-champ-masse]')!;
		const champAjustement = form.querySelector<HTMLElement>('[data-champ-ajustement]')!;
		const selectAjustee = form.querySelector<HTMLSelectElement>('[data-ajustee]')!;

		form.querySelectorAll<HTMLButtonElement>('[data-unite]').forEach((bouton) => {
			bouton.addEventListener('click', () => {
				unite = bouton.dataset.unite as 'kg' | 'pct';
				form.querySelectorAll('[data-unite]').forEach((b) => b.classList.toggle('est-actif', b === bouton));
				champMasse.hidden = unite === 'kg';
				champAjustement.hidden = unite === 'kg';
				form.querySelectorAll('[data-unite-libelle]').forEach((u) => {
					u.textContent = unite === 'kg' ? 'kg' : '%';
				});
				CATEGORIES.forEach((c) => {
					const input = form.querySelector<HTMLInputElement>(`[data-categorie-valeur="${c}"]`)!;
					input.placeholder = String(EXEMPLES[unite][c as keyof typeof EXEMPLES.kg]);
					input.value = '';
					input.readOnly = false;
				});
				recalculer();
			});
		});
		selectAjustee.addEventListener('change', recalculer);

		// ---------------------------------------------------------- Calcul
		const bilan = form.querySelector<HTMLElement>('[data-bilan]')!;
		const barre = resultat.querySelector<HTMLElement>('[data-barre]')!;
		const bulleBarre = resultat.querySelector<HTMLElement>('[data-barre-bulle]')!;
		const legende = resultat.querySelector<HTMLElement>('[data-legende]')!;
		const detailPostes = resultat.querySelector<HTMLElement>('[data-detail-postes]')!;
		const listeComparaisons = resultat.querySelector<HTMLElement>('[data-comparaisons]')!;
		const listeHypotheses = resultat.querySelector<HTMLElement>('[data-hypotheses]')!;
		const couleurs: Record<string, string> = {
			fabrication: 'var(--bleu)',
			transport: 'var(--bleu-clair)',
			usage: 'var(--orange)',
		};

		function recalculer() {
			const masseSaisie = lire(champ('[data-valeur="masse"]'));
			const ajustee = unite === 'pct' ? selectAjustee.value : '';

			const details: Record<string, Record<string, number>> = {};
			for (const c of CATEGORIES) {
				const panneau = form.querySelector<HTMLElement>(`[data-detail="${c}"]`)!;
				if (panneau.hidden) continue;
				const lignes: Record<string, number> = {};
				panneau.querySelectorAll<HTMLInputElement>('[data-sous]').forEach((i) => {
					const v = Number(i.value) || 0;
					if (v > 0) lignes[i.dataset.sousCle!] = unite === 'kg' ? v : (v / 100) * masseSaisie;
				});
				if (Object.keys(lignes).length) details[c] = lignes;
			}

			const brutes: Record<string, number> = {};
			for (const c of CATEGORIES) {
				const input = form.querySelector<HTMLInputElement>(`[data-categorie-valeur="${c}"]`)!;
				if (details[c]) {
					const somme = Object.values(details[c]).reduce((a, b) => a + b, 0);
					input.value =
						unite === 'kg'
							? String(Math.round(somme))
							: String(masseSaisie > 0 ? Math.round((somme / masseSaisie) * 100) : 0);
					input.readOnly = true;
					brutes[c] = Number(input.value);
				} else if (c !== ajustee) {
					input.readOnly = false;
					brutes[c] = lire(input);
				}
			}

			let ecart = 0;
			if (unite === 'pct') {
				if (ajustee && !details[ajustee]) {
					const autres = CATEGORIES.filter((c) => c !== ajustee).reduce((s, c) => s + (brutes[c] ?? 0), 0);
					brutes[ajustee] = Math.max(0, 100 - autres);
					const input = form.querySelector<HTMLInputElement>(`[data-categorie-valeur="${ajustee}"]`)!;
					input.value = String(Math.round(brutes[ajustee]));
					input.readOnly = true;
				}
				ecart = CATEGORIES.reduce((s, c) => s + (brutes[c] ?? 0), 0) - 100;
			}

			const categories: Record<string, number> = {};
			for (const c of CATEGORIES) {
				categories[c] = unite === 'kg' ? (brutes[c] ?? 0) : ((brutes[c] ?? 0) / 100) * masseSaisie;
			}

			const r = calculer({
				categories,
				details,
				puissance: lire(champ('[data-valeur="puissance"]')),
				tauxDeCharge: lire(champ('[data-valeur="charge"]')) / 100,
				heuresParAn: lire(champ('[data-valeur="heures"]')),
				dureeDeVie: lire(champ('[data-valeur="duree"]')),
				distanceLivraison: lire(champ('[data-valeur="distance"]')),
			});

			// En kilogrammes, la masse totale est une information : elle est calculée.
			// En pourcentage, elle a été saisie : la répéter n'apprendrait rien.
			const tropOuPasAssez = unite === 'pct' && Math.abs(ecart) >= 1;
			bilan.textContent = tropOuPasAssez
				? typo(`Les parts saisies font ${Math.round(100 + ecart)} % au lieu de 100 %.`)
				: unite === 'kg' && r.masseTotale > 0
					? typo(`Masse totale : ${Math.round(r.masseTotale).toLocaleString('fr-FR')} kg`)
					: '';
			bilan.classList.toggle('bilan--alerte', tropOuPasAssez);

			if (r.masseTotale <= 0) {
				resultat.hidden = true;
				return;
			}

			resultat.querySelector('[data-total-bas]')!.textContent = formaterCO2e(r.totalBas);
			resultat.querySelector('[data-total-haut]')!.textContent = formaterCO2e(r.totalHaut);

			listeComparaisons.replaceChildren(
				...r.comparaisons.map((c) => {
					const li = document.createElement('li');
					li.textContent = typo(
						'soit ' + c.gabarit.replace('{n}', `${arrondiParlant(c.bas)} à ${arrondiParlant(c.haut)}`)
					);
					return li;
				})
			);

			const chiffres = r.postes.filter((p) => p.bas !== null && p.haut !== null);
			const milieu = (p: { bas: number | null; haut: number | null }) => (p.bas! + p.haut!) / 2;
			const totalMilieu = chiffres.reduce((s, p) => s + milieu(p), 0);

			barre.replaceChildren(
				...chiffres
					.filter((p) => milieu(p) > 0)
					.map((p) => {
						const part = (milieu(p) / totalMilieu) * 100;
						const segment = document.createElement('button');
						segment.type = 'button';
						segment.className = 'barre__part';
						segment.style.width = `${part}%`;
						segment.style.background = couleurs[p.cle];
						// Un poste minuscule garde une zone de survol utilisable, sans être
						// dessiné plus large qu'il n'est.
						if (part < 4) segment.classList.add('barre__part--menue');
						// Le libellé du poste est gardé à part : dans la bulle, il est en gras.
						const valeurs = typo(
							`${formaterCO2e(p.bas!)} à ${formaterCO2e(p.haut!)}, soit ${
								part < 1 ? '< 1' : Math.round(part)
							} % du total`
						);
						segment.setAttribute('aria-label', typo(`${p.libelle} : ${valeurs}`));
						const montrer = () => {
							const nom = document.createElement('strong');
							nom.textContent = p.libelle;
							bulleBarre.replaceChildren(nom, document.createTextNode(typo(` : ${valeurs}`)));
							bulleBarre.hidden = false;
							bulleBarre.style.left = `${segment.offsetLeft + segment.offsetWidth / 2}px`;
							bulleBarre.style.setProperty('--decalage', '0px');
							const r2 = bulleBarre.getBoundingClientRect();
							const marge = 8;
							let d = 0;
							if (r2.left < marge) d = marge - r2.left;
							else if (r2.right > innerWidth - marge) d = innerWidth - marge - r2.right;
							bulleBarre.style.setProperty('--decalage', `${Math.round(d)}px`);
						};
						segment.addEventListener('mouseenter', montrer);
						segment.addEventListener('focus', montrer);
						segment.addEventListener('mouseleave', () => (bulleBarre.hidden = true));
						segment.addEventListener('blur', () => (bulleBarre.hidden = true));
						return segment;
					})
			);

			legende.replaceChildren(
				...chiffres
					.filter((p) => milieu(p) > 0)
					.map((p) => {
						const part = (milieu(p) / totalMilieu) * 100;
						const li = document.createElement('li');
						const pastille = document.createElement('span');
						pastille.className = 'legende__pastille';
						pastille.style.background = couleurs[p.cle];
						li.append(pastille, typo(`${p.libelle} ${part < 1 ? '< 1' : Math.round(part)} %`));
						return li;
					})
			);

			detailPostes.replaceChildren(
				...r.postes.map((p) => {
					const li = document.createElement('li');
					li.textContent = typo(
						p.bas === null
							? `${p.libelle} : non chiffré.`
							: `${p.libelle} : ${formaterCO2e(p.bas)} à ${formaterCO2e(p.haut!)}.`
					);
					return li;
				})
			);

			listeHypotheses.replaceChildren(
				...r.hypotheses.map((h) => {
					const li = document.createElement('li');
					li.textContent = h;
					return li;
				})
			);

			resultat.hidden = false;
		}

		form.addEventListener('input', recalculer);
		recalculer();
	}
</script>

<style>
	.simulateur {
		border: 1px solid var(--gris-moyen);
		border-radius: var(--rayon);
		padding: clamp(1.25rem, 3vw, 2rem);
	}
	/* Posée dans une page, la version compacte est une carte claire : elle reste lisible
	   sur un fond sombre comme sur un fond blanc. */
	/* La carte est claire mais peut être posée dans un bloc sombre : la couleur du texte
	   doit être reprise explicitement, sinon elle hérite du blanc et devient illisible. */
	.simulateur--compact,
	.resultat--compact {
		color: var(--gris);
	}
